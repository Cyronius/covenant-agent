# Agent Core GBNF (llama.cpp grammar) — R2 Condition A syntax constraint.
# Derived from spec/agent_core.md §3. Deliberately permissive where GBNF
# cannot track context (indentation discipline, block-head/body pairing,
# register binding): those violations are caught by core/parser + typecheck,
# which is the point — this grammar only removes free-text failure modes.
# The optional EFFECTS header is omitted (references omit it too).

root      ::= line* termline
line      ::= indent (instr | "STOP" | ret | abort) nl | instr nl
termline  ::= ("STOP" | "PAUSE" | ret | abort) nl?
# `line` requires an indent before STOP/RETURN/ABORT: at column 0 those are
# only ever `termline`. With `indent?` they were also a legal `line`, so the
# grammar stayed live after a top-level "STOP\n" and nothing stopped an
# untuned model writing the program again — LFM2.5-8B-A1B and the 27B both
# emitted a correct program then repeated it to the token cap. Everything
# after a column-0 terminator is UNREACHABLE by definition, so this forbids
# only programs the checker already rejects. Tuned checkpoints put ~1.0 on
# EOG there and are unaffected (verified on E-crowded, 2026-09-06).
# The newline after the terminator MUST be optional. SFT targets are
# stripped (make_sft.py), so the tuned model puts ~1.0 on <|im_end|>
# immediately after "STOP"; a mandatory `nl` leaves the grammar in a
# non-accepting state there, llama.cpp masks EOG, the sampler is forced to
# emit "\n", and the model lands in a state it never trained on (P(EOG)
# drops to ~0.02, P("CALL") ~0.23) — it then rambles to max_tokens and
# every extra line is UNREACHABLE. See .claude/plans/
# grammar-terminator-newline.md and probe_stop.py for the measurements.
# PAUSE is only a terminator (never in `line`): with PAUSE also in `line`,
# "PAUSE\n" was ambiguous and the same masking hit every L10 task. STOP
# stays in `line` for early exits inside IF bodies.
ret       ::= "RETURN " operand
abort     ::= "ABORT " ("NOT_FOUND" | "AMBIGUOUS" | "UNSUPPORTED" | "NEEDS_INFO") (" " sym)? (" " sym)?
sym       ::= tool | field | const
indent    ::= "  " | "    " | "      " | "        "
nl        ::= "\n"

instr     ::= let | get | set | call | formatin | filterin | mapin | countin | sortin | mostin | selectin | firstin | foreachin | ifin | "ELSE" | "PARALLEL" | tryin

let       ::= "LET " operand arrow
get       ::= "GET " reg "." field arrow
set       ::= "SET " reg " " field " " operand arrow
call      ::= "CALL " tool (" " operand)* (arrow)?
formatin  ::= "FORMAT " const (" " operand)* arrow
filterin  ::= "FILTER " reg " " pred arrow
mapin     ::= "MAP " reg " " field arrow
countin   ::= "COUNT " reg arrow
sortin    ::= "SORT " reg " " field " " ("ASC" | "DESC") arrow
# spec 0.4.0 §4: MOST / LEAST with an optional candidate list
mostin    ::= ("MOST " | "LEAST ") reg " " field (" " reg)? arrow
selectin  ::= "SELECT " reg " " operand arrow
firstin   ::= "FIRST " reg arrow
foreachin ::= "FOREACH " reg arrow
ifin      ::= "IF " cond
tryin     ::= "TRY " ("RETRY " num " ")? "-> " reg

arrow     ::= " -> " reg

pred      ::= clause ((" AND " | " OR ") clause)*
clause    ::= ("NOT ")? field " " cmp " " (operand | field)
cond      ::= ccl ((" AND " | " OR ") ccl)*
ccl       ::= ("NOT ")? (operand " " cmp " " operand | "EMPTY " reg)
cmp       ::= "EQ" | "LT" | "GT" | "CONTAINS"

operand   ::= regfield | reg | const | "NOW" | "NULL" | num
regfield  ::= reg "." field
reg       ::= "r1" [0-5] | "r" [0-9]
# These three rules are the *fallback* form. harness/task_grammar.py rewrites
# them per task, enumerating exactly the T/F/C symbols the prompt declares, so
# an undeclared symbol cannot be decoded at all. Use that path for anything
# scored; this file alone is for callers with no symbol table to hand (the
# browser demo fetches it as static text).
#
# `num` was [0-9] [0-9]? until 2026-09-06, which capped every symbol at 99.
# Crowded contexts declare 150+ fields, so the right answer was unspellable:
# llama.cpp masked the third digit and the sampler committed to the two-digit
# prefix (F14 for F142), which the typechecker then reported as UNKNOWN_FIELD.
# 122 of 300 e_crowded_v2 tasks needed an F>=100 and every one of them failed;
# the remaining 178 scored 97.2%. See results/S2.md §S3.
tool      ::= "T" num
field     ::= "F" num
const     ::= ("C" | "S" | "N" | "B" | "D" | "I") num
num       ::= [0-9] [0-9]? [0-9]?
