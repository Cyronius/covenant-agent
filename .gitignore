# bulk generated corpora stay out of git; the curriculum reference set and
# holdout reservation are tracked explicitly
data/*.jsonl
!data/curriculum_tasks.jsonl
data/holdout/*.jsonl
!data/holdout/e_demo_requests.jsonl
# strict-clean real requests, request text + tool names only (owner rule 2026-09-02)
!data/holdout/e_real_sessions.jsonl
data/*_shards/
data/r1_batches/
data/r1_authored/
.claude/plans/
__pycache__/
*.pyc
.pytest_cache/
baselines/qwen/models/
.codegraph/
node_modules/
dist/

# raw production session pulls (PII) - never committed; only the scrubbed, reviewed eval slice is tracked
data/real_sessions/
# `/*` not `/`: git cannot re-include a file inside an excluded directory,
# and the note recording the corrected inventory is tracked
data/open_pairs/*
!data/open_pairs/README.md

# R3 tiny-model experiment (models/tiny): tensors, checkpoints, generations
# and pod bundles stay local; the code, results/R3.md and results/logs are tracked
models/tiny/data_cache*/
models/tiny/runs/
models/tiny/out/
models/tiny/*.tar.gz
*.pt
# Scored runs brought back from a pod: the generations are megabytes each and
# regenerable from a checkpoint, the score summaries are what every table in
# results/ is computed from, so those are tracked.
models/tiny/out_*/**/*.jsonl
models/tiny/out_*/*.jsonl
!models/tiny/out_*/curves/**/log.jsonl
models/tiny/*.log
# the ELECTRA reader (tern_electra.py, slot_reader.py, slot_tagger.py,
# electra_reader.py, electra_cache.py, pack_reader.py): parsed role corpora
# (~75 MB), teacher targets, embedding heads, cache patches, packed .bin
# readers and run dirs are regenerable; curated logs live in results/logs
models/tiny/reader/slots/
models/tiny/reader/tern_electra/
models/tiny/reader/embed/
models/tiny/reader/*.bin
# Ternlight leftovers on disk (R25's role readers, the downloaded weights):
# nothing reads them since 2026-10-04; delete when convenient
models/tiny/reader/role/
models/tiny/reader/ternlight-mini/

# NPU tooling (models/npu): build output and the driver link library we
# reconstruct from the installed driver. Vendored headers and the shim are tracked.
models/npu/build/

# decoy-audit corpora (harness/decoy_audit.py): regenerable
data/audit*/

# general-English corpus (data/gen/general_corpus.py): regenerable, raw Google docs cached inside
data/general/
