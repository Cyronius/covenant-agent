# bulk generated corpora stay out of git; the curriculum reference set and
# holdout reservation are tracked explicitly
data/*.jsonl
!data/curriculum_tasks.jsonl
data/holdout/*.jsonl
!data/holdout/e_demo_requests.jsonl
# strict-clean real requests, request text + tool names only (owner rule 2026-09-02)
!data/holdout/e_real_sessions.jsonl
data/*_shards/
data/r1_batches/
data/r1_authored/
.claude/plans/
__pycache__/
*.pyc
.pytest_cache/
baselines/qwen/models/
.codegraph/
node_modules/
dist/

# raw production session pulls (PII) - never committed; only the scrubbed, reviewed eval slice is tracked
data/real_sessions/
data/open_pairs/

# R3 tiny-model experiment (models/tiny): tensors, checkpoints, generations
# and pod bundles stay local; the code, results/R3.md and results/logs are tracked
models/tiny/data_cache*/
models/tiny/runs/
models/tiny/out/
models/tiny/*.tar.gz
*.pt
# Scored runs brought back from a pod: the generations are megabytes each and
# regenerable from a checkpoint, the score summaries are what every table in
# results/ is computed from, so those are tracked.
models/tiny/out_*/**/*.jsonl
models/tiny/out_*/*.jsonl
!models/tiny/out_*/curves/**/log.jsonl
models/tiny/*.log

# NPU tooling (models/npu): build output and the driver link library we
# reconstruct from the installed driver. Vendored headers and the shim are tracked.
models/npu/build/
