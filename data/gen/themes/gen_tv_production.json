{
  "domain": "tv_production",
  "desc_style": "terse",
  "parent": {
    "entity": "network",
    "noun": ["network", "networks"],
    "name_style": "company",
    "contact_field": "email"
  },
  "child": {
    "entity": "shoot",
    "noun": ["shoot", "shoots"],
    "ref_field": "network",
    "ref_phrase": "for {name}",
    "name_field": "episode",
    "titles": ["Pilot: First Light", "The Long Table Read", "Static on the Line",
               "Backlot Blues", "The Understudy Cut", "Night Shoot at Pier 9",
               "Rewrite on the Fly", "The Green Room", "Second Unit Sundown",
               "Cross-Cut", "The Wrap Party Episode", "Rain Cover"],
    "bools": [
      {"field": "permit_secured", "true_phrase": "permitted",
       "false_phrase": "no permit", "placement": "pre"}
    ],
    "enum": {
      "field": "status", "values": ["prepped", "shooting", "wrapped", "scrapped"],
      "phrases": {"prepped": ["in prep", "pre"],
                  "shooting": ["shooting", "pre"],
                  "wrapped": ["wrapped", "pre"],
                  "scrapped": ["scrapped", "pre"]}
    },
    "times": [
      {"field": "call_time", "kind": "time_now",
       "lt_phrase": ["already called", "post"],
       "gt_phrase": ["not yet called", "post"]}
    ],
    "number": {"field": "shoot_days", "noun": "shoot length in days", "min": 1, "max": 20}
  },
  "tools": {
    "list_child": {"name": "lsShoots",
                   "desc": "list all shoot days",
                   "decoys": [
                     {"name": "lsRehearsals", "desc": "list all rehearsal days"},
                     {"name": "lsScouts", "desc": "list all scout days"},
                     {"name": "lsTravel", "desc": "list all travel days"}]},
    "get_child": {"name": "getShoot",
                  "desc": "fetch one shoot day rec",
                  "decoys": [
                    {"name": "getCallsheet", "desc": "fetch one shoot's call sheet"},
                    {"name": "getShotlist", "desc": "fetch one shoot's shot list"},
                    {"name": "getCrewlist", "desc": "fetch one shoot's crew list"}]},
    "list_parent": {"name": "lsNetworks",
                    "desc": "list all network accts",
                    "decoys": [
                      {"name": "lsContacts", "desc": "list all network contacts"},
                      {"name": "lsDeals", "desc": "list all network deals"},
                      {"name": "lsBudgets", "desc": "list all network budgets"}]},
    "get_parent": {"name": "getNetwork",
                   "desc": "fetch one network acct",
                   "decoys": [
                     {"name": "getSpecs", "desc": "fetch one network's specs"},
                     {"name": "getSlate", "desc": "fetch one network's slate"},
                     {"name": "getBudget", "desc": "fetch one network's budget"}]},
    "delete_child": {"name": "scrubShoot",
                     "desc": "wipe a shoot day rec, no undo",
                     "verbs": ["scrub {obj}", "wipe {obj} from the board"],
                     "decoys": [
                       {"name": "purgeDailies", "desc": "wipe a shoot's dailies, no undo",
                        "verbs": ["purge the dailies from {obj}", "wipe the footage for {obj}"]},
                       {"name": "dropHolds", "desc": "drop a shoot's crew holds, no undo",
                        "verbs": ["drop the crew holds on {obj}", "release the crew for {obj}"]},
                       {"name": "voidLocation", "desc": "void a shoot's loc deal, no undo",
                        "verbs": ["void the location deal on {obj}", "kill the loc agreement for {obj}"]}]},
    "set_enum": {"name": "setShootStatus",
                 "desc": "chg shoot status",
                 "verbs": ["set {obj} {to_value}", "mark {obj} {to_value}"],
                 "value_phrases": {"prepped": "back to prep",
                                   "shooting": "to shooting",
                                   "wrapped": "as wrapped",
                                   "scrapped": "as scrapped"},
                 "decoys": [
                   {"name": "setUnitStatus", "desc": "chg 2nd unit status"},
                   {"name": "setLocStatus", "desc": "chg location status"},
                   {"name": "setBuildStatus", "desc": "chg set build status"}]},
    "set_bool": {"name": "flagPermit",
                 "bool_index": 0, "value": true,
                 "desc": "mark shoot permitted",
                 "verbs": ["flag {obj} as permitted", "mark {obj} permit-secured"],
                 "decoys": [
                   {"name": "flagInsured", "desc": "mark shoot insured",
                    "verbs": ["flag {obj} as insured", "mark {obj} COI-secured"]},
                   {"name": "flagCleared", "desc": "mark shoot cleared",
                    "verbs": ["flag {obj} as cleared", "mark {obj} legal-cleared"]},
                   {"name": "flagClosed", "desc": "mark shoot closed-set",
                    "verbs": ["flag {obj} as a closed set", "mark {obj} closed-set"]}]},
    "set_ref": {"name": "reassignNetwork",
                "desc": "move shoot to diff network",
                "verbs": ["move {obj} {to_name}", "reassign {obj} {to_name}"],
                "to_template": "to {name}",
                "decoys": [
                  {"name": "billNetwork", "desc": "bill shoot to diff network",
                   "verbs": ["bill {obj} {to_name}", "charge {obj} {to_name}"]},
                  {"name": "licenseNetwork", "desc": "license shoot to diff network",
                   "verbs": ["license {obj} {to_name}", "license the footage from {obj} {to_name}"]},
                  {"name": "shareNetwork", "desc": "share shoot with diff network",
                   "verbs": ["share {obj} out {to_name}", "send the dailies for {obj} {to_name}"]}]},
    "send": {"name": "pingNetwork",
             "desc": "msg the network re: shoot",
             "child_verbs": ["ping the network behind {obj}",
                             "message the network for {obj}"],
             "direct_verbs": ["ping {name}", "message {name}"],
             "pair_verbs": ["message", "notify"],
             "decoys": [
               {"name": "callNetwork", "desc": "call the network re: shoot",
                "child_verbs": ["call the network behind {obj}", "phone the network for {obj}"],
                "direct_verbs": ["call {name}", "phone {name}"],
                "pair_verbs": ["call", "phone"]},
               {"name": "invoiceNetwork", "desc": "invoice the network re: shoot",
                "child_verbs": ["invoice the network behind {obj}", "send an invoice to the network for {obj}"],
                "direct_verbs": ["invoice {name}", "send {name} an invoice"],
                "pair_verbs": ["invoice", "send an invoice to"]},
               {"name": "reportNetwork", "desc": "report to network re: shoot",
                "child_verbs": ["file a report with the network behind {obj}", "report {obj} to its network"],
                "direct_verbs": ["file a report with {name}", "report to {name}"],
                "pair_verbs": ["report to", "file a report with"]}]}
  },
  "v2": {
    "create": {"name": "newShoot", "desc": "new shoot for a network, opt episode + status",
              "decoys": [
                {"name": "newScout", "desc": "new scout for a network, opt episode + status"},
                {"name": "newRehearsal", "desc": "new rehearsal for a network, opt episode + status"},
                {"name": "newPitch", "desc": "new pitch for a network, opt episode + status"}]},
    "list_notes": {"name": "lsShootNotes", "desc": "list notes on a shoot",
                  "decoys": [
                    {"name": "lsShootTakes", "desc": "list takes on a shoot"},
                    {"name": "lsShootScenes", "desc": "list scenes on a shoot"},
                    {"name": "lsShootProps", "desc": "list props on a shoot"}]},
    "add_note": {"name": "addShootNote", "desc": "add note to a shoot, opt title",
                "decoys": [
                  {"name": "addShootTake", "desc": "add take to a shoot, opt title"},
                  {"name": "addShootScene", "desc": "add scene to a shoot, opt title"},
                  {"name": "addShootProp", "desc": "add prop to a shoot, opt title"}]},
    "update_note": {"name": "editShootNote", "desc": "edit text (opt title) of a shoot note",
                   "decoys": [
                     {"name": "editShootTake", "desc": "edit text (opt title) of a shoot take"},
                     {"name": "editShootScene", "desc": "edit text (opt title) of a shoot scene"},
                     {"name": "editShootProp", "desc": "edit text (opt title) of a shoot prop"}]},
    "delete_note": {"name": "rmShootNote", "desc": "rm a note from a shoot, no undo",
                   "decoys": [
                     {"name": "rmShootTake", "desc": "rm a take from a shoot, no undo"},
                     {"name": "rmShootScene", "desc": "rm a scene from a shoot, no undo"},
                     {"name": "rmShootProp", "desc": "rm a prop from a shoot, no undo"}]},
    "set_image": {"name": "setShootImg", "desc": "set image on a shoot",
                 "decoys": [
                   {"name": "setShootStoryboard", "desc": "set storyboard on a shoot"},
                   {"name": "setShootMap", "desc": "set loc map on a shoot"},
                   {"name": "setShootArt", "desc": "set key art on a shoot"}]},
    "writer": {"name": "writeMsg", "desc": "write short msg from brief + shoots to mention, returns text",
              "decoys": [
                {"name": "writeLogline", "desc": "write short logline from brief + shoots to cover, returns text"},
                {"name": "writeRecap", "desc": "write short wrap recap from brief + shoots to cover, returns text"},
                {"name": "writePress", "desc": "write short press note from brief + shoots to mention, returns text"}]},
    "image": {"name": "genImg", "desc": "gen image from prompt, opt style, returns URL",
             "decoys": [
               {"name": "genStoryboard", "desc": "gen storyboard from prompt, opt style, returns URL"},
               {"name": "genPoster", "desc": "gen poster from prompt, opt style, returns URL"},
               {"name": "genSlate", "desc": "gen slate from prompt, opt style, returns URL"}]},
    "search": {"name": "searchHelp", "desc": "search help docs + kb w/ a question, returns best passage",
              "decoys": [
                {"name": "searchGuild", "desc": "search guild rules w/ a question, returns best passage"},
                {"name": "searchScripts", "desc": "search script library w/ a question, returns best passage"},
                {"name": "searchSpecs", "desc": "search delivery specs w/ a question, returns best passage"}]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the shoot with the earliest call time",
    "ord_phrase": "the shoot with the {ord} earliest call time",
    "pre_filter": {"enum_value": "shooting", "phrase": "shooting"}
  },
  "ambiguous": [
    {"request": ["Sort the scrapped days.",
                 "Clean up the dead shoots."],
     "hint": "scrub scrapped shoots whose call time already passed",
     "clauses": [{"enum_value": "scrapped"},
                 {"time_index": 0, "op": "LT"}],
     "action": "delete_child"},
    {"request": ["Handle the permit gaps.",
                 "Deal with the unpermitted shoots."],
     "hint": "flag shooting-status shoots as permitted",
     "clauses": [{"enum_value": "shooting"}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["Your shoot day needs a status check.",
                   "There's an update on your scheduled shoot.",
                   "Production has flagged your shoot for review.",
                   "Your shoot may need a call time change."],
    "agg_msgs": ["You have the most shoot days on the board.",
                 "You're leading the network in active shoots.",
                 "You hold the longest-running shoot block."],
    "fail_msgs": ["The shoot update failed.",
                  "That request was rejected by the scheduling board.",
                  "The change did not save."]
  }
}
