{
  "domain": "animal_shelter",
  "desc_style": "terse",
  "parent": {
    "entity": "adopter",
    "noun": ["adopter", "adopters"],
    "name_style": "person",
    "contact_field": "email"
  },
  "child": {
    "entity": "adoption_case",
    "noun": ["adoption case", "adoption cases"],
    "ref_field": "adopter",
    "ref_phrase": "for {name}",
    "name_field": "animal",
    "titles": ["Senior tabby cat - Whiskers", "Young lab mix - Buddy",
               "Bonded pair of rabbits", "Elderly beagle - Duke",
               "Kitten litter - tuxedo mix", "Special needs dog - three-legged",
               "Feral cat - barn placement", "Parakeet pair",
               "Blind senior dog - Daisy", "Shy shepherd mix - Luna",
               "Guinea pig trio", "Deaf dalmatian - Patches",
               "Pregnant stray cat", "Retired greyhound - Zeus"],
    "bools": [
      {"field": "foster_to_adopt", "true_phrase": "foster-to-adopt",
       "false_phrase": "direct adoption", "placement": "pre"},
      {"field": "home_visit_done", "true_phrase": "home visit done",
       "false_phrase": "home visit pending", "placement": "post"}
    ],
    "enum": {
      "field": "disposition", "values": ["pending", "approved", "denied", "completed"],
      "phrases": {"pending": ["pending", "pre"],
                  "approved": ["approved", "pre"],
                  "denied": ["denied", "pre"],
                  "completed": ["completed", "pre"]}
    },
    "times": [
      {"field": "meet_greet", "kind": "time_now",
       "lt_phrase": ["already happened", "post"],
       "gt_phrase": ["still upcoming", "post"]},
      {"field": "applied", "kind": "time_cutoff",
       "phrase": "applied more than {d} days ago"}
    ]
  },
  "tools": {
    "list_child": {"name": "list_adoption_cases", "desc": "list open adoption cases"},
    "get_child": {"name": "get_adoption_case", "desc": "fetch one case by id"},
    "list_parent": {"name": "list_adopters", "desc": "list all adopters on file"},
    "get_parent": {"name": "get_adopter", "desc": "fetch one adopter by id"},
    "delete_child": {"name": "delete_adoption_case",
                     "desc": "remove a case rec, no undo",
                     "verbs": ["delete {obj}", "purge {obj}"]},
    "set_enum": {"name": "set_case_disposition",
                 "desc": "set case disposition: pending/approved/denied/completed",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"pending": "back to pending",
                                   "approved": "as approved",
                                   "denied": "as denied",
                                   "completed": "as completed"}},
    "set_bool": {"name": "flag_home_visit_done",
                 "bool_index": 1, "value": true,
                 "desc": "mark home visit done",
                 "verbs": ["mark {obj} home visit done",
                           "flag {obj} as home visit done"]},
    "set_ref": {"name": "reassign_adopter",
                "desc": "move a case to a diff adopter",
                "verbs": ["move {obj} {to_name}", "reassign {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "email_adopter",
             "desc": "email an adopter",
             "child_verbs": ["email the adopter behind {obj}",
                             "notify the adopter behind {obj}"],
             "direct_verbs": ["email {name}", "send {name} an email"],
             "pair_verbs": ["email", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the adoption case with the earliest meet and greet",
    "ord_phrase": "the adoption case with the {ord} earliest meet and greet",
    "pre_filter": {"enum_value": "pending", "phrase": "pending"}
  },
  "ambiguous": [
    {"request": ["clear out the dead cases",
                 "the case list is cluttered, clean it up"],
     "hint": "delete denied cases applied more than 200 days ago",
     "clauses": [{"enum_value": "denied"},
                 {"time_index": 1, "days": 200}],
     "action": "delete_child"},
    {"request": ["check on the ones already met",
                 "handle the cases past their meet and greet"],
     "hint": "mark pending cases whose meet and greet already happened as home visit done",
     "clauses": [{"enum_value": "pending"},
                 {"time_index": 0, "op": "LT"}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["Your adoption case needs attention.",
                   "Please review your open adoption case.",
                   "A note about your adoption case.",
                   "Your adoption case may need follow-up."],
    "agg_msgs": ["You have the most open cases right now.",
                 "Flagging this to you directly.",
                 "You lead this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
