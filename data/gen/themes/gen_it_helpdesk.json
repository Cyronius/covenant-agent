{
  "domain": "it_helpdesk",
  "desc_style": "sloppy",
  "parent": {
    "entity": "requester",
    "noun": ["requester", "requesters"],
    "name_style": "company",
    "contact_field": "email"
  },
  "child": {
    "entity": "incident",
    "noun": ["incident", "incidents"],
    "ref_field": "requester",
    "ref_phrase": "for {name}",
    "name_field": "summary",
    "titles": ["VPN drops every few minutes", "Printer offline on 3rd floor",
               "Cannot log into email", "Laptop won't boot past logo",
               "Shared drive permissions wrong", "Password reset needed",
               "Monitor flickering", "Software license expired",
               "Wifi unstable in east wing", "Two-factor codes not arriving",
               "Disk space critically low", "Application crashes on launch"],
    "bools": [
      {"field": "escalated", "true_phrase": "escalated",
       "false_phrase": "not escalated", "placement": "pre"},
      {"field": "sla_breached", "true_phrase": "past SLA",
       "false_phrase": "within SLA", "placement": "post"}
    ],
    "enum": {
      "field": "phase", "values": ["open", "in_progress", "resolved", "closed"],
      "phrases": {"open": ["open", "pre"],
                  "in_progress": ["in progress", "pre"],
                  "resolved": ["resolved", "pre"],
                  "closed": ["closed", "pre"]}
    },
    "times": [
      {"field": "opened_at", "kind": "time_cutoff",
       "phrase": "opened more than {d} days ago"}
    ]
  },
  "tools": {
    "list_child": {"name": "list_incidents",
                   "desc": "lists all incidents in the queue, dont filter by req"},
    "get_child": {"name": "get_incident",
                  "desc": "grabs one incident by id"},
    "list_parent": {"name": "list_requesters",
                    "desc": "lists requesters (the companies that file incidents)"},
    "get_parent": {"name": "get_requester",
                   "desc": "grabs a single requester by id"},
    "delete_child": {"name": "purge_incident",
                     "desc": "nukes an incident rec, cant be undone",
                     "verbs": ["purge {obj}", "nuke {obj} from the queue"]},
    "set_enum": {"name": "set_incident_phase",
                 "desc": "sets incident phase - open/in progress/resolved/closed",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"open": "back to open",
                                   "in_progress": "as in progress",
                                   "resolved": "as resolved",
                                   "closed": "as closed"}},
    "set_bool": {"name": "flag_sla_breach",
                 "bool_index": 1, "value": true,
                 "desc": "flags incident as past sla, use when its way overdue",
                 "verbs": ["flag {obj} as past sla", "mark {obj} sla breached"]},
    "set_ref": {"name": "reassign_requester",
                "desc": "moves an incident to a diff requester acct",
                "verbs": ["move {obj} {to_name}", "reassign {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "email_requester",
             "desc": "fires off an email to the requester",
             "child_verbs": ["email the requester of {obj}",
                             "ping the requester of {obj}"],
             "direct_verbs": ["email {name}", "ping {name}"],
             "pair_verbs": ["email", "ping"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the incident that was opened longest ago",
    "ord_phrase": "the incident with the {ord} oldest opened time",
    "pre_filter": {"enum_value": "open", "phrase": "open"}
  },
  "ambiguous": [
    {"request": ["Clean up the stale queue.", "The queue's a mess, deal with it."],
     "hint": "delete incidents still open and opened more than 30 days ago",
     "clauses": [{"enum_value": "open"},
                 {"time_index": 0, "days": 30}],
     "action": "delete_child"},
    {"request": ["Handle the incidents that blew their SLA.", "Deal with the ones way overdue."],
     "hint": "flag as SLA breached incidents still open and opened more than 5 days ago",
     "clauses": [{"enum_value": "open"},
                 {"time_index": 0, "days": 5}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["Your incident needs attention.",
                   "Please review your open incident.",
                   "A note about your support incident.",
                   "Your incident may need follow-up."],
    "agg_msgs": ["You currently top this list.",
                 "Flagging this incident to you directly.",
                 "You lead this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
