{
  "domain": "library",
  "desc_style": "terse",
  "parent": {
    "entity": "patron",
    "noun": ["patron", "patrons"],
    "name_style": "person",
    "contact_field": "email"
  },
  "child": {
    "entity": "loan",
    "noun": ["loan", "loans"],
    "ref_field": "patron",
    "ref_phrase": "for {name}",
    "name_field": "title",
    "titles": ["The Silent Orchard", "Under a Copper Sky", "The Last Lighthouse Keeper",
               "Salt and Stone", "A History of Small Towns", "The Clockmaker's Daughter",
               "River Bend", "Winter in Halden", "The Paper Cartographer",
               "Season of Ash", "The Quiet Algorithm", "Marigold Lane",
               "The Glassblower's Apprentice"],
    "bools": [
      {"field": "renewed", "true_phrase": "renewed",
       "false_phrase": "not yet renewed", "placement": "pre"},
      {"field": "damaged", "true_phrase": "returned damaged",
       "false_phrase": "in good condition", "placement": "post"}
    ],
    "enum": {
      "field": "phase", "values": ["checked_out", "returned", "overdue", "lost"],
      "phrases": {"checked_out": ["checked out", "pre"],
                  "returned": ["returned", "pre"],
                  "overdue": ["overdue", "pre"],
                  "lost": ["lost", "pre"]}
    },
    "times": [
      {"field": "due_date", "kind": "time_now",
       "lt_phrase": ["already overdue", "post"],
       "gt_phrase": ["not yet due", "post"]}
    ]
  },
  "tools": {
    "list_child": {"name": "listLoans",
                   "desc": "list all loan recs"},
    "get_child": {"name": "getLoan",
                  "desc": "fetch one loan by id"},
    "list_parent": {"name": "listPatrons",
                    "desc": "list registered patrons"},
    "get_parent": {"name": "getPatron",
                   "desc": "fetch one patron by id"},
    "delete_child": {"name": "purgeLoan",
                     "desc": "wipe a loan rec, no undo",
                     "verbs": ["purge {obj}", "wipe {obj} from the catalog"]},
    "set_enum": {"name": "setLoanPhase",
                 "desc": "change loan phase (checked out/returned/overdue/lost)",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"checked_out": "back to checked out",
                                   "returned": "as returned",
                                   "overdue": "as overdue",
                                   "lost": "as lost"}},
    "set_bool": {"name": "flagDamaged",
                 "bool_index": 1, "value": true,
                 "desc": "flag a loan's book as damaged",
                 "verbs": ["flag {obj} as damaged", "mark {obj} returned damaged"]},
    "set_ref": {"name": "transferPatron",
                "desc": "move a loan to a different patron",
                "verbs": ["move {obj} {to_name}", "transfer {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "emailPatron",
             "desc": "email a patron",
             "child_verbs": ["email the patron of {obj}",
                             "give the patron of {obj} a nudge"],
             "direct_verbs": ["email {name}", "send {name} an email"],
             "pair_verbs": ["email", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the loan with the earliest due date",
    "ord_phrase": "the loan with the {ord} earliest due date",
    "pre_filter": {"enum_value": "checked_out", "phrase": "checked out"}
  },
  "ambiguous": [
    {"request": ["Clear the overdue shelf.", "Deal with the loans nobody returned."],
     "hint": "delete loans still checked out and already overdue",
     "clauses": [{"enum_value": "checked_out"},
                 {"time_index": 0, "op": "LT"}],
     "action": "delete_child"}
  ],
  "banks": {
    "child_msgs": ["Your loan needs attention.",
                   "Please renew your loan soon.",
                   "A note about your borrowed book.",
                   "Your loan may be overdue."],
    "agg_msgs": ["You currently have the most items out.",
                 "Flagging this loan to you directly.",
                 "You lead this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
