{
  "domain": "courier_service",
  "desc_style": "clean",
  "parent": {
    "entity": "client",
    "noun": ["client", "clients"],
    "name_style": "company",
    "contact_field": "email"
  },
  "child": {
    "entity": "delivery",
    "noun": ["delivery", "deliveries"],
    "ref_field": "client",
    "ref_phrase": "for {name}",
    "name_field": "contents",
    "titles": ["Legal document envelope", "Medical specimen kit", "E-commerce return box",
               "Retail apparel package", "Spare parts box", "Perishable gift basket",
               "Office supplies carton", "Electronics parcel", "Signed contract packet",
               "Prescription medication box", "Sample product kit", "Promotional materials box"],
    "bools": [
      {"field": "signature_required", "true_phrase": "signature required",
       "false_phrase": "no signature needed", "placement": "post"}
    ],
    "enum": {
      "field": "status", "values": ["picked_up", "in_transit", "out_for_delivery", "delivered"],
      "phrases": {"picked_up": ["picked up", "pre"],
                  "in_transit": ["in transit", "pre"],
                  "out_for_delivery": ["out for delivery", "post"],
                  "delivered": ["delivered", "pre"]}
    },
    "times": [
      {"field": "eta", "kind": "time_now",
       "lt_phrase": ["past due", "post"],
       "gt_phrase": ["still on time", "post"]}
    ]
  },
  "tools": {
    "list_child": {"name": "listDeliveries",
                   "desc": "List every parcel delivery in the system."},
    "get_child": {"name": "getDelivery",
                  "desc": "Fetch one delivery by its id."},
    "list_parent": {"name": "listClients",
                    "desc": "List all courier client accounts."},
    "get_parent": {"name": "getClient",
                   "desc": "Fetch one client by id."},
    "delete_child": {"name": "cancelDelivery",
                     "desc": "Permanently remove a delivery record. Not reversible.",
                     "verbs": ["cancel {obj}", "scrap {obj} from the manifest"]},
    "set_enum": {"name": "setDeliveryStatus",
                 "desc": "Change a delivery's status (picked up, in transit, out for delivery, or delivered).",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"picked_up": "back to picked up",
                                   "in_transit": "as in transit",
                                   "out_for_delivery": "as out for delivery",
                                   "delivered": "as delivered"}},
    "set_bool": {"name": "requireSignature",
                 "bool_index": 0, "value": true,
                 "desc": "Flag a delivery as requiring a signature on receipt.",
                 "verbs": ["flag {obj} as signature required", "mark {obj} signature required"]},
    "set_ref": {"name": "rebillClient",
                "desc": "Move a delivery to a different client account.",
                "verbs": ["move {obj} {to_name}", "rebill {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "emailClient",
             "desc": "Send an email update to a courier client.",
             "child_verbs": ["email the client behind {obj}", "notify the client behind {obj}"],
             "direct_verbs": ["email {name}", "notify {name}"],
             "pair_verbs": ["email", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the delivery with the earliest ETA",
    "ord_phrase": "the delivery with the {ord} earliest ETA",
    "pre_filter": {"enum_value": "in_transit", "phrase": "in transit"}
  },
  "ambiguous": [
    {"request": ["Clear out the late ones.",
                 "Handle whatever's overdue."],
     "hint": "flag in-transit deliveries past their ETA as needing a signature",
     "clauses": [{"enum_value": "in_transit"},
                 {"time_index": 0, "op": "LT"}],
     "action": "set_bool"},
    {"request": ["Cancel the stuck orders.",
                 "The queue is a mess, clean it up."],
     "hint": "cancel picked-up deliveries that never left transit",
     "clauses": [{"enum_value": "picked_up"}],
     "action": "delete_child"}
  ],
  "banks": {
    "child_msgs": ["Your delivery needs attention.",
                   "Please review your delivery status.",
                   "A note about your delivery.",
                   "Your delivery may be delayed."],
    "agg_msgs": ["Your account tops this list right now.",
                 "Flagging this to your account directly.",
                 "Your account leads this count."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
