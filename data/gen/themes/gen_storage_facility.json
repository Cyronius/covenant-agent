{
  "domain": "storage_facility",
  "desc_style": "sloppy",
  "parent": {
    "entity": "renter",
    "noun": ["renter", "renters"],
    "name_style": "person",
    "contact_field": null
  },
  "child": {
    "entity": "unit_rental",
    "noun": ["unit rental", "unit rentals"],
    "ref_field": "renter",
    "ref_phrase": "for {name}",
    "name_field": "unit_size",
    "titles": ["5x5 Small Closet Unit", "5x10 Small Unit", "10x10 Medium Unit",
               "10x15 Medium Unit", "10x20 Large Unit", "10x30 Extra Large Unit",
               "Climate Controlled 10x10", "Drive-Up 10x20",
               "Vehicle Storage Bay", "Boat Storage Slip", "Wine Storage Locker",
               "Business Records Unit", "Outdoor RV Parking Space",
               "Rooftop Storage Cage"],
    "bools": [
      {"field": "auto_pay", "true_phrase": "on auto-pay",
       "false_phrase": "not on auto-pay", "placement": "post"},
      {"field": "past_due", "true_phrase": "past due",
       "false_phrase": "current", "placement": "pre"}
    ],
    "enum": {
      "field": "status", "values": ["active", "vacated", "auctioned"],
      "phrases": {"active": ["active", "pre"],
                  "vacated": ["vacated", "pre"],
                  "auctioned": ["auctioned", "pre"]}
    },
    "times": [
      {"field": "rent_due", "kind": "time_now",
       "lt_phrase": ["already past due", "post"],
       "gt_phrase": ["not due yet", "post"]}
    ]
  },
  "tools": {
    "list_child": {"name": "listUnitRentals", "desc": "list all the unit rentals we got"},
    "get_child": {"name": "getUnitRental", "desc": "grab one unit rental by id"},
    "list_parent": {"name": "listRenters", "desc": "list every renter on file"},
    "get_parent": {"name": "getRenter", "desc": "grab one renter by id"},
    "delete_child": {"name": "deleteUnitRental",
                     "desc": "nukes a unit rental record, no undo",
                     "verbs": ["delete {obj}", "wipe {obj} outta the system"]},
    "set_enum": {"name": "setRentalStatus",
                 "desc": "change rental status - active, vacated or auctioned, w/e fits",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"active": "back to active",
                                   "vacated": "as vacated",
                                   "auctioned": "as auctioned"}},
    "set_bool": {"name": "flagPastDue",
                 "bool_index": 1, "value": true,
                 "desc": "flag a unit as past due, renter aint paid",
                 "verbs": ["flag {obj} as past due", "mark {obj} past due"]},
    "set_ref": {"name": "reassignRenter",
                "desc": "move a unit rental to a diff renter",
                "verbs": ["move {obj} {to_name}", "reassign {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "textRenter",
             "desc": "text a renter bout their unit",
             "child_verbs": ["text the renter behind {obj}",
                             "give the renter behind {obj} a heads up"],
             "direct_verbs": ["text {name}", "send {name} a text"],
             "pair_verbs": ["text", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the unit rental with the soonest rent due date",
    "ord_phrase": "the unit rental with the {ord} soonest rent due date",
    "pre_filter": {"enum_value": "active", "phrase": "active"}
  },
  "ambiguous": [
    {"request": ["clear out the closed units",
                 "get rid of the ones thats done"],
     "hint": "delete vacated unit rentals whose rent due date already passed",
     "clauses": [{"enum_value": "vacated"},
                 {"time_index": 0, "op": "LT"}],
     "action": "delete_child"},
    {"request": ["deal with the late payers",
                 "handle the ones behind on rent"],
     "hint": "flag active unit rentals whose rent due date already passed as past due",
     "clauses": [{"enum_value": "active"},
                 {"time_index": 0, "op": "LT"}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["Your unit rental needs attention.",
                   "Please review your storage unit rental.",
                   "A note about your unit rental.",
                   "Your unit rental may need action."],
    "agg_msgs": ["You currently top this list.",
                 "Flagging this to you directly.",
                 "You lead this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
