{
  "domain": "legal_practice",
  "desc_style": "sloppy",
  "parent": {
    "entity": "client",
    "noun": ["client", "clients"],
    "name_style": "company",
    "contact_field": "email"
  },
  "child": {
    "entity": "matter",
    "noun": ["matter", "matters"],
    "ref_field": "client",
    "ref_phrase": "for {name}",
    "name_field": "case_type",
    "titles": ["Contract dispute", "Personal injury claim", "Employment discrimination",
               "Trademark infringement", "Real estate closing", "Estate planning",
               "Corporate merger review", "Divorce proceeding", "Patent application",
               "Landlord-tenant dispute", "Regulatory compliance review", "Breach of warranty claim"],
    "bools": [
      {"field": "conflict_flag", "true_phrase": "conflict flagged",
       "false_phrase": "cleared", "placement": "pre"}
    ],
    "enum": {
      "field": "phase", "values": ["intake", "active", "settled", "closed"],
      "phrases": {"intake": ["in intake", "post"],
                  "active": ["active", "pre"],
                  "settled": ["settled", "pre"],
                  "closed": ["closed", "pre"]}
    },
    "times": [
      {"field": "next_hearing", "kind": "time_now",
       "lt_phrase": ["already passed", "post"],
       "gt_phrase": ["still upcoming", "post"]},
      {"field": "filed", "kind": "time_cutoff",
       "phrase": "filed more than {d} days ago"}
    ]
  },
  "tools": {
    "list_child": {"name": "listMatters",
                   "desc": "list all the matters we got on file"},
    "get_child": {"name": "getMatter",
                  "desc": "grab one matter by id"},
    "list_parent": {"name": "listClients",
                    "desc": "list all clients on the books"},
    "get_parent": {"name": "getClient",
                   "desc": "grab one client by id"},
    "delete_child": {"name": "killMatter",
                     "desc": "nuke a matter record, cant undo it",
                     "verbs": ["kill {obj}", "wipe {obj} for good"]},
    "set_enum": {"name": "setMatterPhase",
                 "desc": "chnage a matters phase (intake/active/settled/closed)",
                 "verbs": ["move {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"intake": "back to intake",
                                   "active": "to active",
                                   "settled": "to settled",
                                   "closed": "to closed"}},
    "set_bool": {"name": "flagConflict",
                 "bool_index": 0, "value": true,
                 "desc": "flag a matter for a conflict check, needs review asap",
                 "verbs": ["flag {obj} for conflict", "mark {obj} conflicted"]},
    "set_ref": {"name": "reassignMatter",
                "desc": "move a matter over to a diff client, for when its filed wrong",
                "verbs": ["reassign {obj} {to_name}", "move {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "emailClient",
             "desc": "fire off an email to a client, quick update or w/e",
             "child_verbs": ["email the client on {obj}",
                             "shoot the client on {obj} an update"],
             "direct_verbs": ["email {name}", "send {name} an email"],
             "pair_verbs": ["email", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the matter with the soonest next hearing",
    "ord_phrase": "the matter with the {ord} soonest next hearing",
    "pre_filter": {"enum_value": "active", "phrase": "active"}
  },
  "ambiguous": [
    {"request": ["Clear the dead intake pile.",
                 "Nobody's touched these, get rid of them."],
     "hint": "delete intake matters filed more than 120 days ago",
     "clauses": [{"enum_value": "intake"},
                 {"time_index": 1, "days": 120}],
     "action": "delete_child"},
    {"request": ["Deal with the missed hearings.",
                 "Some of these fell through the cracks."],
     "hint": "flag active matters whose next hearing already passed for a conflict check",
     "clauses": [{"enum_value": "active"},
                 {"time_index": 0, "op": "LT"}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["Your matter needs attention.",
                   "Please review your open matter.",
                   "A note about your matter.",
                   "Your matter may need follow-up."],
    "agg_msgs": ["You're currently at the top of this list.",
                 "Flagging this to you directly.",
                 "You lead this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
