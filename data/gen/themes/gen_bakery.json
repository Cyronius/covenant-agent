{
  "domain": "bakery",
  "desc_style": "sloppy",
  "parent": {
    "entity": "customer",
    "noun": ["customer", "customers"],
    "name_style": "person",
    "contact_field": "email"
  },
  "child": {
    "entity": "production_order",
    "noun": ["production order", "production orders"],
    "ref_field": "customer",
    "ref_phrase": "for {name}",
    "name_field": "item",
    "titles": ["Sourdough loaf", "Croissant tray", "Birthday cake",
               "Wedding cake tier", "Baguette batch", "Cinnamon rolls",
               "Bagel dozen", "Rye loaf", "Cupcake tray", "Danish pastry tray",
               "Focaccia sheet", "Pie order", "Cookie tray", "Brioche loaf"],
    "bools": [
      {"field": "rush", "true_phrase": "rush",
       "false_phrase": "standard", "placement": "pre"}
    ],
    "enum": {
      "field": "status", "values": ["queued", "baking", "cooling", "fulfilled"],
      "phrases": {"queued": ["queued", "pre"],
                  "baking": ["in the oven", "post"],
                  "cooling": ["cooling", "pre"],
                  "fulfilled": ["fulfilled", "pre"]}
    },
    "times": [
      {"field": "due_by", "kind": "time_now",
       "lt_phrase": ["already late", "post"],
       "gt_phrase": ["not due yet", "post"]}
    ]
  },
  "tools": {
    "list_child": {"name": "list_orders",
                   "desc": "list all prod orders"},
    "get_child": {"name": "get_order",
                  "desc": "grab one order by id"},
    "list_parent": {"name": "list_customers",
                    "desc": "list all customers on file"},
    "get_parent": {"name": "get_customer",
                   "desc": "grab one customer by id"},
    "delete_child": {"name": "nuke_order",
                     "desc": "delete an order, cant undo it",
                     "verbs": ["nuke {obj}", "toss {obj} out"]},
    "set_enum": {"name": "set_order_status",
                 "desc": "change order status (queued/baking/cooling/fulfilled)",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"queued": "back to queued",
                                   "baking": "as baking",
                                   "cooling": "as cooling",
                                   "fulfilled": "as fulfilled"}},
    "set_bool": {"name": "flag_rush",
                 "bool_index": 0, "value": true,
                 "desc": "flag an order as rush",
                 "verbs": ["flag {obj} as rush", "mark {obj} rush"]},
    "set_ref": {"name": "move_customer",
                "desc": "move an order to a diff customer",
                "verbs": ["move {obj} {to_name}", "reassign {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "email_customer",
             "desc": "shoot a customer an email",
             "child_verbs": ["email the customer for {obj}",
                             "ping the customer on {obj}"],
             "direct_verbs": ["email {name}", "send {name} a note"],
             "pair_verbs": ["email", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the production order with the earliest due time",
    "ord_phrase": "the production order with the {ord} earliest due time",
    "pre_filter": {"enum_value": "queued", "phrase": "queued"}
  },
  "ambiguous": [
    {"request": ["sort out the backlog",
                 "the order queue's a mess, deal w it"],
     "hint": "flag queued orders already past due as rush",
     "clauses": [{"enum_value": "queued"},
                 {"time_index": 0, "op": "LT"}],
     "action": "set_bool"},
    {"request": ["clear out old fulfilled orders",
                 "get rid of the stale fulfilled stuff"],
     "hint": "delete fulfilled orders already past due",
     "clauses": [{"enum_value": "fulfilled"},
                 {"time_index": 0, "op": "LT"}],
     "action": "delete_child"}
  ],
  "banks": {
    "child_msgs": ["your order needs a look",
                   "hey check on ur order soon",
                   "order update needed, take a look",
                   "this order might need attention"],
    "agg_msgs": ["ur on top of this list rn",
                 "flagging this one to u",
                 "u lead this count right now"],
    "fail_msgs": ["op failed, sry",
                  "that didnt go thru",
                  "update failed, try again"]
  }
}
