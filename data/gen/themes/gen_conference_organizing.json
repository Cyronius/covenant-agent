{
  "domain": "conference_organizing",
  "desc_style": "clean",
  "parent": {
    "entity": "speaker",
    "noun": ["speaker", "speakers"],
    "name_style": "person",
    "contact_field": null
  },
  "child": {
    "entity": "proposal",
    "noun": ["proposal", "proposals"],
    "ref_field": "speaker",
    "ref_phrase": "from {name}",
    "name_field": "talk_title",
    "titles": ["Scaling Microservices at the Edge",
               "Designing for Accessibility from Day One",
               "The Future of On-Device AI", "Rethinking Database Sharding",
               "Lessons from a Decade of Incident Response",
               "Building Trust in Open Source", "Practical Formal Verification",
               "Green Computing at Data Center Scale",
               "Navigating Technical Debt", "Storytelling for Engineering Leaders",
               "Zero-Downtime Migrations in Practice", "Designing APIs That Age Well",
               "The Economics of Developer Tools", "Privacy-Preserving Machine Learning"],
    "bools": [
      {"field": "needs_av", "true_phrase": "requiring extra AV setup",
       "false_phrase": "standard AV needs", "placement": "post"}
    ],
    "enum": {
      "field": "stage", "values": ["submitted", "accepted", "declined"],
      "phrases": {"submitted": ["submitted", "pre"],
                  "accepted": ["accepted", "pre"],
                  "declined": ["declined", "pre"]}
    },
    "times": [
      {"field": "slot_time", "kind": "time_now",
       "lt_phrase": ["already presented", "post"],
       "gt_phrase": ["still to come", "post"]},
      {"field": "submitted_on", "kind": "time_cutoff",
       "phrase": "submitted more than {d} days ago"}
    ]
  },
  "tools": {
    "list_child": {"name": "lst_props", "desc": "List every talk proposal submitted to the conference."},
    "get_child": {"name": "get_prop", "desc": "Fetch one talk proposal by its id."},
    "list_parent": {"name": "lst_spkrs", "desc": "List all speakers registered with the conference."},
    "get_parent": {"name": "get_spkr", "desc": "Fetch one speaker by id."},
    "delete_child": {"name": "del_prop",
                     "desc": "Permanently remove a talk proposal record. Not reversible.",
                     "verbs": ["del {obj}", "wipe {obj} from the schedule"]},
    "set_enum": {"name": "set_prop_stage",
                 "desc": "Change a proposal's stage (submitted, accepted, or declined).",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"submitted": "back to submitted",
                                   "accepted": "as accepted",
                                   "declined": "as declined"}},
    "set_bool": {"name": "flag_av",
                 "bool_index": 0, "value": true,
                 "desc": "Flag a proposal as requiring extra AV setup.",
                 "verbs": ["flag {obj} as needing extra AV", "mark {obj} AV-heavy"]},
    "set_ref": {"name": "move_spkr",
                "desc": "Move a proposal to a different speaker's record.",
                "verbs": ["move {obj} {to_name}", "reassign {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "msg_spkr",
             "desc": "Send a message to a speaker.",
             "child_verbs": ["message the speaker behind {obj}", "notify the speaker on {obj}"],
             "direct_verbs": ["message {name}", "notify {name}"],
             "pair_verbs": ["message", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the proposal with the earliest slot time",
    "ord_phrase": "the proposal with the {ord} earliest slot time",
    "pre_filter": {"enum_value": "accepted", "phrase": "accepted"}
  },
  "ambiguous": [
    {"request": ["Clean up the leftover proposals.", "Sort out the proposal backlog."],
     "hint": "delete declined proposals submitted more than 45 days ago",
     "clauses": [{"enum_value": "declined"},
                 {"time_index": 1, "days": 45}],
     "action": "delete_child"},
    {"request": ["Flag the talks that'll need extra setup.", "Deal with the AV-heavy sessions."],
     "hint": "flag accepted proposals whose slot time is already past as requiring extra AV setup",
     "clauses": [{"enum_value": "accepted"},
                 {"time_index": 0, "op": "LT"}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["Your proposal needs attention.",
                   "Please review your talk proposal.",
                   "A note about your proposal.",
                   "Your proposal may need updated details."],
    "agg_msgs": ["You currently top this list.",
                 "Flagging this to you directly.",
                 "You lead this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
