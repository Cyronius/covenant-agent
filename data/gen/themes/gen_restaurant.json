{
  "domain": "restaurant",
  "desc_style": "clean",
  "parent": {
    "entity": "guest",
    "noun": ["guest", "guests"],
    "name_style": "person",
    "contact_field": "phone"
  },
  "child": {
    "entity": "reservation",
    "noun": ["reservation", "reservations"],
    "ref_field": "guest",
    "ref_phrase": "for {name}",
    "name_field": "occasion",
    "titles": ["Anniversary dinner", "Birthday celebration", "Business dinner",
               "Date night", "Family gathering", "Graduation dinner",
               "Holiday party", "Engagement dinner", "Retirement dinner",
               "Client entertaining", "Pre-theater dinner", "Wine tasting dinner",
               "Chef's table experience", "Girls' night out"],
    "bools": [
      {"field": "vip", "true_phrase": "VIP",
       "false_phrase": "standard", "placement": "pre"}
    ],
    "enum": {
      "field": "status", "values": ["requested", "confirmed", "seated", "cancelled"],
      "phrases": {"requested": ["requested", "pre"],
                  "confirmed": ["confirmed", "pre"],
                  "seated": ["seated", "pre"],
                  "cancelled": ["cancelled", "pre"]}
    },
    "times": [
      {"field": "table_time", "kind": "time_now",
       "lt_phrase": ["already past", "post"],
       "gt_phrase": ["still upcoming", "post"]}
    ]
  },
  "tools": {
    "list_child": {"name": "list_reservations",
                   "desc": "List every reservation on the books."},
    "get_child": {"name": "get_reservation",
                  "desc": "Fetch one reservation by its id."},
    "list_parent": {"name": "list_guests",
                    "desc": "List all guests on file."},
    "get_parent": {"name": "get_guest",
                   "desc": "Fetch one guest by id."},
    "delete_child": {"name": "delete_reservation",
                     "desc": "Permanently remove a reservation record. Not reversible.",
                     "verbs": ["delete {obj}", "remove {obj} from the books"]},
    "set_enum": {"name": "set_reservation_status",
                 "desc": "Change a reservation's status (requested, confirmed, seated, or cancelled).",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"requested": "back to requested",
                                   "confirmed": "as confirmed",
                                   "seated": "as seated",
                                   "cancelled": "as cancelled"}},
    "set_bool": {"name": "flag_vip",
                 "bool_index": 0, "value": true,
                 "desc": "Flag a reservation as VIP.",
                 "verbs": ["flag {obj} as VIP", "mark {obj} VIP"]},
    "set_ref": {"name": "transfer_guest",
                "desc": "Move a reservation to a different guest's account.",
                "verbs": ["move {obj} {to_name}", "transfer {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "call_guest",
             "desc": "Call a guest by phone.",
             "child_verbs": ["call the guest for {obj}",
                             "give the guest of {obj} a ring"],
             "direct_verbs": ["call {name}", "phone {name}"],
             "pair_verbs": ["call", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the reservation with the earliest table time",
    "ord_phrase": "the reservation with the {ord} earliest table time",
    "pre_filter": {"enum_value": "confirmed", "phrase": "confirmed"}
  },
  "ambiguous": [
    {"request": ["Clear out the dead reservations.",
                 "The cancelled ones are just clutter, get rid of them."],
     "hint": "delete cancelled reservations already past their table time",
     "clauses": [{"enum_value": "cancelled"},
                 {"time_index": 0, "op": "LT"}],
     "action": "delete_child"}
  ],
  "banks": {
    "child_msgs": ["Your reservation needs attention.",
                   "Please review your upcoming reservation.",
                   "A note about your reservation.",
                   "Your reservation may need rescheduling."],
    "agg_msgs": ["You currently top this list.",
                 "Flagging this to you directly.",
                 "You lead this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
