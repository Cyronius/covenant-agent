{
  "domain": "payroll",
  "desc_style": "terse",
  "parent": {
    "entity": "employee",
    "noun": ["employee", "employees"],
    "name_style": "person",
    "contact_field": "phone"
  },
  "child": {
    "entity": "pay_run",
    "noun": ["pay run", "pay runs"],
    "ref_field": "employee",
    "ref_phrase": "for {name}",
    "name_field": null,
    "titles": [],
    "bools": [
      {"field": "held", "true_phrase": "on hold",
       "false_phrase": "released", "placement": "pre"}
    ],
    "enum": {
      "field": "status", "values": ["draft", "approved", "paid", "voided"],
      "phrases": {"draft": ["draft", "pre"],
                  "approved": ["approved", "pre"],
                  "paid": ["paid out", "post"],
                  "voided": ["voided", "pre"]}
    },
    "times": [
      {"field": "period_end", "kind": "time_now",
       "lt_phrase": ["already closed", "post"],
       "gt_phrase": ["still open", "post"]},
      {"field": "processed", "kind": "time_cutoff",
       "phrase": "processed more than {d} days ago"}
    ]
  },
  "tools": {
    "list_child": {"name": "listPayRuns",
                   "desc": "list all pay runs"},
    "get_child": {"name": "getPayRun",
                  "desc": "fetch one pay run by id"},
    "list_parent": {"name": "listEmployees",
                    "desc": "list employees on payroll"},
    "get_parent": {"name": "getEmployee",
                   "desc": "fetch one employee by id"},
    "delete_child": {"name": "purgePayRun",
                     "desc": "delete a pay run rec, no undo",
                     "verbs": ["purge {obj}", "wipe {obj} from payroll"]},
    "set_enum": {"name": "setPayRunStatus",
                 "desc": "chg pay run status (draft/approved/paid/voided)",
                 "verbs": ["set {obj} {to_value}", "mark {obj} {to_value}"],
                 "value_phrases": {"draft": "back to draft",
                                   "approved": "to approved",
                                   "paid": "as paid",
                                   "voided": "as voided"}},
    "set_bool": {"name": "flagHeld",
                 "bool_index": 0, "value": true,
                 "desc": "put a hold on a pay run",
                 "verbs": ["hold {obj}", "flag {obj} on hold"]},
    "set_ref": {"name": "reassignPayRun",
                "desc": "move a pay run to a diff employee acct",
                "verbs": ["reassign {obj} {to_name}", "move {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "textEmployee",
             "desc": "send a text to an employee",
             "child_verbs": ["text the employee on {obj}",
                             "ping the employee on {obj}"],
             "direct_verbs": ["text {name}", "send {name} a text"],
             "pair_verbs": ["text", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the pay run with the earliest period end",
    "ord_phrase": "the pay run with the {ord} earliest period end",
    "pre_filter": {"bool_index": 0, "value": false, "phrase": "not on hold"}
  },
  "ambiguous": [
    {"request": ["Clear out the old drafts.",
                 "These drafts have been sitting too long, deal with it."],
     "hint": "delete draft pay runs whose period has already closed",
     "clauses": [{"enum_value": "draft"},
                 {"time_index": 0, "op": "LT"}],
     "action": "delete_child"},
    {"request": ["Put a hold on the backlog.",
                 "Something's off with the old ones, freeze them."],
     "hint": "flag as held the approved pay runs processed more than 45 days ago",
     "clauses": [{"enum_value": "approved"},
                 {"time_index": 1, "days": 45}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["Your pay run needs attention.",
                   "Please review your latest pay run.",
                   "A note about your pay run.",
                   "Your pay run may need correction."],
    "agg_msgs": ["You're at the top of this list.",
                 "Flagging this to you directly.",
                 "You lead this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
