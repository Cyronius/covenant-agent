{
  "domain": "pharmacy",
  "desc_style": "terse",
  "parent": {
    "entity": "customer",
    "noun": ["customer", "customers"],
    "name_style": "person",
    "contact_field": "phone"
  },
  "child": {
    "entity": "order",
    "noun": ["order", "orders"],
    "ref_field": "customer",
    "ref_phrase": "for {name}",
    "name_field": "medication",
    "titles": ["Lisinopril 10mg", "Metformin 500mg", "Atorvastatin 20mg",
               "Amoxicillin 500mg", "Levothyroxine 75mcg", "Albuterol inhaler",
               "Omeprazole 20mg", "Sertraline 50mg", "Amlodipine 5mg",
               "Gabapentin 300mg", "Hydrochlorothiazide 25mg", "Prednisone 10mg"],
    "bools": [
      {"field": "refill_authorized", "true_phrase": "refill-authorized",
       "false_phrase": "no refills left", "placement": "pre"}
    ],
    "enum": {
      "field": "stage", "values": ["received", "filled", "ready", "picked_up"],
      "phrases": {"received": ["received", "pre"],
                  "filled": ["filled", "pre"],
                  "ready": ["ready", "pre"],
                  "picked_up": ["picked up", "pre"]}
    },
    "times": [
      {"field": "received_at", "kind": "time_cutoff",
       "phrase": "received more than {d} days ago"}
    ]
  },
  "tools": {
    "list_child": {"name": "list_orders",
                   "desc": "list all rx orders"},
    "get_child": {"name": "get_order",
                  "desc": "fetch one rx order by id"},
    "list_parent": {"name": "list_customers",
                    "desc": "list registered customers"},
    "get_parent": {"name": "get_customer",
                   "desc": "fetch one customer by id"},
    "delete_child": {"name": "purge_order",
                     "desc": "wipe an rx order rec, no undo",
                     "verbs": ["purge {obj}", "wipe {obj} from the queue"]},
    "set_enum": {"name": "set_order_stage",
                 "desc": "change rx order stage: received/filled/ready/picked up",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"received": "back to received",
                                   "filled": "as filled",
                                   "ready": "as ready",
                                   "picked_up": "as picked up"}},
    "set_bool": {"name": "flag_refill",
                 "bool_index": 0, "value": true,
                 "desc": "authorize a refill on an rx order",
                 "verbs": ["authorize a refill on {obj}", "flag {obj} as refill-authorized"]},
    "set_ref": {"name": "reassign_customer",
                "desc": "move an rx order to a diff customer",
                "verbs": ["move {obj} {to_name}", "reassign {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "text_customer",
             "desc": "text a customer their rx status",
             "child_verbs": ["text the customer of {obj}",
                             "give the customer of {obj} a heads-up"],
             "direct_verbs": ["text {name}", "send {name} a text"],
             "pair_verbs": ["text", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the order that was received longest ago",
    "ord_phrase": "the order with the {ord} oldest received time",
    "pre_filter": {"enum_value": "received", "phrase": "received"}
  },
  "ambiguous": [
    {"request": ["Clear the backlog at the counter.", "The queue's piling up, deal with it."],
     "hint": "delete orders still received and received more than 10 days ago",
     "clauses": [{"enum_value": "received"},
                 {"time_index": 0, "days": 10}],
     "action": "delete_child"}
  ],
  "banks": {
    "child_msgs": ["Your prescription order needs attention.",
                   "Please check on your order.",
                   "A note about your prescription order.",
                   "Your order may need a refill."],
    "agg_msgs": ["You currently top this list.",
                 "Flagging this order to you directly.",
                 "You lead this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
