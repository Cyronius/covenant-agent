{
  "domain": "university_registrar",
  "desc_style": "clean",
  "parent": {
    "entity": "student",
    "noun": ["student", "students"],
    "name_style": "person",
    "contact_field": "email"
  },
  "child": {
    "entity": "enrollment",
    "noun": ["enrollment", "enrollments"],
    "ref_field": "student",
    "ref_phrase": "for {name}",
    "name_field": "course_title",
    "titles": ["Intro to Psychology", "Calculus I", "Organic Chemistry",
               "World History Since 1900", "Data Structures", "Microeconomics",
               "English Composition", "Statistics for Social Science",
               "Cell Biology", "Linear Algebra", "Public Speaking",
               "Environmental Science", "Art History Survey", "Intro to Sociology"],
    "bools": [
      {"field": "repeat_attempt", "true_phrase": "a repeat attempt",
       "false_phrase": "a first attempt", "placement": "post"},
      {"field": "honors", "true_phrase": "honors-designated",
       "false_phrase": "standard", "placement": "pre"}
    ],
    "enum": {
      "field": "status", "values": ["enrolled", "waitlisted", "dropped"],
      "phrases": {"enrolled": ["enrolled", "pre"],
                  "waitlisted": ["waitlisted", "pre"],
                  "dropped": ["dropped", "pre"]}
    },
    "times": [
      {"field": "class_start", "kind": "time_now",
       "lt_phrase": ["already underway", "post"],
       "gt_phrase": ["not yet started", "post"]},
      {"field": "registered_on", "kind": "time_cutoff",
       "phrase": "registered more than {d} days ago"}
    ]
  },
  "tools": {
    "list_child": {"name": "list_enrollments",
                   "desc": "List every enrollment on file for the term."},
    "get_child": {"name": "get_enrollment",
                  "desc": "Fetch one enrollment record by its id."},
    "list_parent": {"name": "list_students",
                    "desc": "List all students in the registrar system."},
    "get_parent": {"name": "get_student",
                   "desc": "Fetch one student by id."},
    "delete_child": {"name": "drop_enrollment",
                     "desc": "Permanently remove an enrollment record. Not reversible.",
                     "verbs": ["drop {obj}", "purge {obj} from the roster"]},
    "set_enum": {"name": "set_enrollment_status",
                 "desc": "Change an enrollment's status (enrolled, waitlisted, or dropped).",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"enrolled": "back to enrolled",
                                   "waitlisted": "as waitlisted",
                                   "dropped": "as dropped"}},
    "set_bool": {"name": "flag_honors",
                 "bool_index": 1, "value": true,
                 "desc": "Mark an enrollment as honors-designated.",
                 "verbs": ["flag {obj} as honors", "mark {obj} honors-designated"]},
    "set_ref": {"name": "transfer_student",
                "desc": "Move an enrollment to a different student's record.",
                "verbs": ["move {obj} {to_name}", "transfer {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "email_student",
             "desc": "Send an email to a student.",
             "child_verbs": ["email the student in {obj}",
                             "notify the student on {obj}"],
             "direct_verbs": ["email {name}", "send {name} an email"],
             "pair_verbs": ["email", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the enrollment with the earliest class start",
    "ord_phrase": "the enrollment with the {ord} earliest class start",
    "pre_filter": {"enum_value": "enrolled", "phrase": "enrolled"}
  },
  "ambiguous": [
    {"request": ["Clean up the waitlist.", "The waitlist is out of control, fix it."],
     "hint": "drop waitlisted enrollments whose class already started",
     "clauses": [{"enum_value": "waitlisted"},
                 {"time_index": 0, "op": "LT"}],
     "action": "delete_child"},
    {"request": ["Sort out who deserves recognition.", "Handle the honors flagging backlog."],
     "hint": "flag enrolled students whose class already started as honors-designated",
     "clauses": [{"enum_value": "enrolled"},
                 {"time_index": 0, "op": "LT"}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["Your enrollment needs attention.",
                   "Please review your course enrollment.",
                   "A note about your enrollment.",
                   "Your enrollment may need action before the drop deadline."],
    "agg_msgs": ["You currently top this list.",
                 "Flagging this to you directly.",
                 "You lead this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
