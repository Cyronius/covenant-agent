{
  "domain": "volunteer_center",
  "desc_style": "terse",
  "parent": {
    "entity": "volunteer",
    "noun": ["volunteer", "volunteers"],
    "name_style": "person",
    "contact_field": "email"
  },
  "child": {
    "entity": "signup",
    "noun": ["signup", "signups"],
    "ref_field": "volunteer",
    "ref_phrase": "by {name}",
    "name_field": "task",
    "titles": ["Food sorting shift", "Front desk coverage", "Warehouse loading",
               "Client intake support", "Phone bank outreach", "Event setup crew",
               "Donation receiving", "Kids' activity table", "Transportation pickup",
               "Newsletter stuffing", "Supply inventory count", "Cleanup crew"],
    "bools": [
      {"field": "background_checked", "true_phrase": "cleared",
       "false_phrase": "uncleared", "placement": "pre"},
      {"field": "needs_training", "true_phrase": "needs training",
       "false_phrase": "trained", "placement": "post"},
      {"field": "no_show", "true_phrase": "no-show",
       "false_phrase": "showed", "placement": "pre"}
    ],
    "enum": {
      "field": "stage", "values": ["requested", "confirmed", "completed", "withdrawn"],
      "phrases": {"requested": ["requested", "pre"],
                  "confirmed": ["confirmed", "pre"],
                  "completed": ["completed", "pre"],
                  "withdrawn": ["withdrawn", "pre"]}
    },
    "times": [
      {"field": "shift_start", "kind": "time_now",
       "lt_phrase": ["already started", "post"],
       "gt_phrase": ["not started yet", "post"]}
    ],
    "number": {"field": "shift_hours", "noun": "shift length in hours", "min": 2, "max": 10}
  },
  "tools": {
    "list_child": {"name": "ls_brd_sup",
                   "desc": "list signups on shift board",
                   "decoys": [
                     {"name": "ls_evt_sup", "desc": "list signups on event roster"},
                     {"name": "ls_wait_sup", "desc": "list signups on wait list"},
                     {"name": "ls_grp_sup", "desc": "list signups from group portal"}]},
    "get_child": {"name": "get_sup_slip",
                  "desc": "get signup slip by id",
                  "decoys": [
                    {"name": "get_sup_hrs", "desc": "get signup hours log by id"},
                    {"name": "get_sup_wvr", "desc": "get signup waiver by id"},
                    {"name": "get_sup_gear", "desc": "get signup gear rec by id"}]},
    "list_parent": {"name": "ls_mem_vol",
                    "desc": "list volunteers in member db",
                    "decoys": [
                      {"name": "ls_alum_vol", "desc": "list volunteers on alumni list"},
                      {"name": "ls_corp_vol", "desc": "list volunteers on corp teams"},
                      {"name": "ls_crt_vol", "desc": "list volunteers on court referrals"}]},
    "get_parent": {"name": "get_vol_file",
                   "desc": "get volunteer file by id",
                   "decoys": [
                     {"name": "get_vol_hrs", "desc": "get volunteer hours rec by id"},
                     {"name": "get_vol_ec", "desc": "get volunteer ice contact by id"},
                     {"name": "get_vol_skills", "desc": "get volunteer skills by id"}]},
    "delete_child": {"name": "rm_sup_slip",
                     "desc": "del signup slip, no undo",
                     "verbs": ["rm {obj}", "kill {obj}"],
                     "decoys": [
                       {"name": "void_sup_hrs", "desc": "void signup hours, no undo",
                        "verbs": ["void the hours on {obj}", "kill the logged hours for {obj}"]},
                       {"name": "rm_sup_wvr", "desc": "del signup waiver, no undo",
                        "verbs": ["delete the waiver on {obj}", "rm the waiver for {obj}"]},
                       {"name": "purge_sup_med", "desc": "purge signup med rec, no undo",
                        "verbs": ["purge the medical form on {obj}", "wipe the med form for {obj}"]}]},
    "set_enum": {"name": "set_sup_stg",
                 "desc": "set signup stage: requested/confirmed/completed/withdrawn",
                 "verbs": ["set {obj} {to_value}", "mark {obj} {to_value}"],
                 "value_phrases": {"requested": "back to requested", "confirmed": "confirmed", "completed": "done", "withdrawn": "withdrawn"},
                 "decoys": [
                   {"name": "plan_sup_stg", "desc": "plan signup stage: requested/confirmed/completed/withdrawn"},
                   {"name": "set_shf_stg", "desc": "set shift stage: requested/confirmed/completed/withdrawn"},
                   {"name": "set_rsvp_stg", "desc": "set rsvp stage: requested/confirmed/completed/withdrawn"}]},
    "set_bool": {"name": "flag_no_show",
                 "bool_index": 2,
                 "value": true,
                 "desc": "flag as no-show",
                 "verbs": ["flag {obj} no-show", "mark {obj} no-show"],
                 "decoys": [
                   {"name": "flag_walk_in", "desc": "flag as walk-in",
                    "verbs": ["flag {obj} walk-in", "mark {obj} walk-in"]},
                   {"name": "flag_on_call", "desc": "flag as on-call",
                    "verbs": ["flag {obj} on-call", "mark {obj} on-call"]},
                   {"name": "flag_left_early", "desc": "flag as left early",
                    "verbs": ["flag {obj} left early", "mark {obj} left early"]}]},
    "set_ref": {"name": "mv_sup_vol",
                "desc": "move signup to diff volunteer",
                "verbs": ["move {obj} {to_name}", "swap {obj} {to_name}"],
                "to_template": "to {name}",
                "decoys": [
                  {"name": "mv_sup_hrs", "desc": "move signup hrs to diff volunteer",
                   "verbs": ["credit the hours on {obj} {to_name}", "move the hours from {obj} {to_name}"]},
                  {"name": "mv_sup_lead", "desc": "move signup lead to diff volunteer",
                   "verbs": ["give the lead on {obj} {to_name}", "move shift lead for {obj} {to_name}"]},
                  {"name": "mv_sup_gear", "desc": "move signup gear to diff volunteer",
                   "verbs": ["loan the gear for {obj} {to_name}", "move the kit from {obj} {to_name}"]}]},
    "send": {"name": "txt_vol",
             "desc": "text a volunteer",
             "child_verbs": ["text the volunteer on {obj}", "ping the volunteer on {obj}"],
             "direct_verbs": ["text {name}", "ping {name}"],
             "pair_verbs": ["text", "ping"],
             "decoys": [
               {"name": "email_vol", "desc": "email a volunteer",
                "child_verbs": ["email the volunteer on {obj}", "mail the volunteer on {obj}"],
                "direct_verbs": ["email {name}", "mail {name}"],
                "pair_verbs": ["email", "mail"]},
               {"name": "call_vol", "desc": "call a volunteer",
                "child_verbs": ["call the volunteer on {obj}", "phone the volunteer on {obj}"],
                "direct_verbs": ["call {name}", "phone {name}"],
                "pair_verbs": ["call", "phone"]},
               {"name": "thank_vol", "desc": "thank a volunteer",
                "child_verbs": ["thank the volunteer on {obj}", "send the volunteer on {obj} a thank-you"],
                "direct_verbs": ["thank {name}", "send {name} a thank-you"],
                "pair_verbs": ["thank", "send thanks to"]}]}
  },
  "v2": {
    "create": {"name": "new_sup",
               "desc": "new signup for volunteer",
               "decoys": [
                 {"name": "new_rsvp", "desc": "new rsvp for volunteer"},
                 {"name": "new_app", "desc": "new application for volunteer"},
                 {"name": "new_intake", "desc": "new intake form for volunteer"}]},
    "list_notes": {"name": "ls_sup_rmk",
                   "desc": "list remarks on signup",
                   "decoys": [
                     {"name": "ls_sup_inc", "desc": "list incidents on signup"},
                     {"name": "ls_sup_fb", "desc": "list feedback on signup"},
                     {"name": "ls_rmk_thr", "desc": "list remark threads on signup"}]},
    "add_note": {"name": "add_sup_rmk",
                 "desc": "add remark to signup",
                 "decoys": [
                   {"name": "add_sup_inc", "desc": "add incident to signup"},
                   {"name": "add_sup_fb", "desc": "add feedback to signup"},
                   {"name": "req_sup_rmk", "desc": "request remark on signup"}]},
    "update_note": {"name": "upd_sup_rmk",
                    "desc": "edit remark text on signup, title opt",
                    "decoys": [
                      {"name": "upd_sup_inc", "desc": "edit incident text on signup, title opt"},
                      {"name": "upd_sup_fb", "desc": "edit feedback text on signup, title opt"},
                      {"name": "ans_sup_rmk", "desc": "answer remark on signup, title opt"}]},
    "delete_note": {"name": "rm_sup_rmk",
                    "desc": "rm remark from signup, no undo",
                    "decoys": [
                      {"name": "rm_sup_inc", "desc": "rm incident from signup, no undo"},
                      {"name": "rm_sup_fb", "desc": "rm feedback from signup, no undo"},
                      {"name": "scrub_sup_rmk", "desc": "scrub remark on signup, no undo"}]},
    "set_image": {"name": "set_sup_icon",
                  "desc": "set signup icon img",
                  "decoys": [
                    {"name": "set_sup_badge", "desc": "set signup badge img"},
                    {"name": "set_sup_map", "desc": "set signup map img"},
                    {"name": "set_sup_grp", "desc": "set signup group img"}]},
    "writer": {"name": "wr_upd",
               "desc": "write short update from brief + signups, returns text",
               "decoys": [
                 {"name": "wr_thx", "desc": "write thank-you note from brief + signups, returns text"},
                 {"name": "wr_sched", "desc": "write short shift schedule from brief + signups, returns text"},
                 {"name": "wr_ref", "desc": "write short reference letter from brief + signups, returns text"}]},
    "image": {"name": "gen_fresh_img",
              "desc": "gen fresh img from prompt, returns url",
              "decoys": [
                {"name": "gen_cert_img", "desc": "gen cert img from prompt, returns url"},
                {"name": "gen_flyer_img", "desc": "gen flyer img from prompt, returns url"},
                {"name": "gen_badge_img", "desc": "gen badge img from prompt, returns url"}]},
    "search": {"name": "srch_help",
               "desc": "search help pages w/ question, returns best passage",
               "decoys": [
                 {"name": "srch_hbk", "desc": "search volunteer handbook w/ question, returns best passage"},
                 {"name": "srch_pol", "desc": "search safety policies w/ question, returns best passage"},
                 {"name": "srch_rel", "desc": "search release notes w/ question, returns best passage"}]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the signup with the earliest shift start",
    "ord_phrase": "the signup with the {ord} earliest shift start",
    "pre_filter": {"enum_value": "confirmed", "phrase": "confirmed"}
  },
  "ambiguous": [
    {"request": ["Clean up the shift roster.",
                 "Roster's a mess, sort it."],
     "hint": "flag confirmed signups whose shift already started as no-show",
     "clauses": [{"enum_value": "confirmed"},
                 {"time_index": 0, "op": "LT"}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["your signup needs a look.",
                   "check your shift signup.",
                   "heads up re: your signup.",
                   "your signup might need changes."],
    "agg_msgs": ["you're on top of this list.",
                 "flagging you directly.",
                 "you lead this count."],
    "fail_msgs": ["op failed.",
                  "that didn't go through.",
                  "last change didn't save."]
  }
}
