{
  "domain": "art_gallery",
  "desc_style": "terse",
  "parent": {
    "entity": "consignor",
    "noun": ["consignor", "consignors"],
    "name_style": "company",
    "contact_field": "phone"
  },
  "child": {
    "entity": "consignment",
    "noun": ["consignment", "consignments"],
    "ref_field": "consignor",
    "ref_phrase": "from {name}",
    "name_field": "piece",
    "titles": ["Vermilion Drift", "Study in Grey No. 7", "Coastal Fracture",
               "Quiet Interior", "Sundial Fragment II", "Blue Hour Triptych",
               "Salt Marsh Study", "Untitled (Ochre)", "Winter Orchard",
               "Reclining Form", "Paper Boats", "Ash and Ember"],
    "bools": [
      {"field": "authenticated", "true_phrase": "authenticated",
       "false_phrase": "unauthenticated", "placement": "pre"},
      {"field": "on_display", "true_phrase": "on display",
       "false_phrase": "in storage", "placement": "post"}
    ],
    "enum": {
      "field": "stage", "values": ["intake", "priced", "listed", "sold"],
      "phrases": {"intake": ["just intaken", "pre"],
                  "priced": ["priced", "pre"],
                  "listed": ["listed for sale", "post"],
                  "sold": ["sold", "pre"]}
    },
    "times": [
      {"field": "listed_on", "kind": "time_cutoff",
       "phrase": "listed more than {d} days ago"}
    ],
    "number": {"field": "asking_price", "noun": "asking price", "min": 150, "max": 9000}
  },
  "tools": {
    "list_child": {"name": "listGalleryLedger",
                   "desc": "list all consignments in gallery ledger",
                   "decoys": [
                     {"name": "listInsuranceSchedule", "desc": "list all consignments on insurance schedule"},
                     {"name": "listShippingManifest", "desc": "list all consignments on shipping manifest"},
                     {"name": "listCatalogueDraft", "desc": "list all consignments in catalogue draft"}]},
    "get_child": {"name": "getConsignmentSheet",
                  "desc": "fetch consignment sheet by id",
                  "decoys": [
                    {"name": "getConditionReport", "desc": "fetch condition report by id"},
                    {"name": "getProvenanceFile", "desc": "fetch provenance file by id"},
                    {"name": "getValuationMemo", "desc": "fetch valuation memo by id"}]},
    "list_parent": {"name": "listConsignorRoster",
                    "desc": "list all consignors on roster",
                    "decoys": [
                      {"name": "listPayoutRun", "desc": "list all consignors on payout run"},
                      {"name": "listGuestList", "desc": "list all consignors on guest list"},
                      {"name": "listMailingList", "desc": "list all consignors on mailing list"}]},
    "get_parent": {"name": "getConsignorProfile",
                   "desc": "fetch consignor profile by id",
                   "decoys": [
                     {"name": "getConsignorStatement", "desc": "fetch consignor statement by id"},
                     {"name": "getConsignorContract", "desc": "fetch consignor contract by id"},
                     {"name": "getConsignorPayouts", "desc": "fetch consignor payouts by id"}]},
    "delete_child": {"name": "scrapConsignmentRec",
                     "desc": "scrap consignment rec, no undo",
                     "verbs": ["pull {obj}", "end the consignment on {obj}"],
                     "decoys": [
                       {"name": "voidConsignmentInvoice", "desc": "void consignment invoice, no undo",
                        "verbs": ["void the invoice on {obj}", "cancel the bill for {obj}"]},
                       {"name": "shredConsignmentContract", "desc": "shred consignment contract, no undo",
                        "verbs": ["shred the contract for {obj}", "tear up the consignment contract on {obj}"]},
                       {"name": "purgeConsignmentPhotos", "desc": "purge consignment photos, no undo",
                        "verbs": ["purge the photos of {obj}", "wipe the image set for {obj}"]}]},
    "set_enum": {"name": "setConsignmentStage",
                 "desc": "set consignment stage (intake/priced/listed/sold)",
                 "verbs": ["move {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"intake": "back to intake",
                                   "priced": "to priced",
                                   "listed": "to listed",
                                   "sold": "to sold"},
                 "decoys": [
                   {"name": "schedConsignmentStage", "desc": "sched consignment stage (intake/priced/listed/sold)"},
                   {"name": "requestConsignmentStage", "desc": "request consignment stage (intake/priced/listed/sold)"},
                   {"name": "alertConsignmentStage", "desc": "alert on consignment stage (intake/priced/listed/sold)"}]},
    "set_bool": {"name": "markAuthenticated",
                 "bool_index": 0, "value": true,
                 "desc": "mark piece authenticated",
                 "verbs": ["mark {obj} authenticated", "flag {obj} as authenticated"],
                 "decoys": [
                   {"name": "markInsured", "desc": "mark piece insured",
                    "verbs": ["mark {obj} insured", "flag {obj} as insured"]},
                   {"name": "markCatalogued", "desc": "mark piece catalogued",
                    "verbs": ["mark {obj} catalogued", "flag {obj} as catalogued"]},
                   {"name": "markPhotographed", "desc": "mark piece photographed",
                    "verbs": ["mark {obj} photographed", "flag {obj} as photographed"]}]},
    "set_ref": {"name": "moveToConsignor",
                "desc": "move piece to another consignor",
                "verbs": ["reassign {obj} {to_name}", "move {obj} {to_name}"],
                "to_template": "to {name}",
                "decoys": [
                  {"name": "billToConsignor", "desc": "bill piece fees to another consignor",
                   "verbs": ["bill {obj} {to_name}", "charge the fees on {obj} {to_name}"]},
                  {"name": "offerToConsignor", "desc": "offer piece to another consignor",
                   "verbs": ["offer {obj} {to_name}", "give first refusal on {obj} {to_name}"]},
                  {"name": "loanToConsignor", "desc": "loan piece to another consignor",
                   "verbs": ["loan {obj} {to_name}", "lend {obj} out {to_name}"]}]},
    "send": {"name": "callConsignor",
             "desc": "call a consignor re: piece",
             "child_verbs": ["call the consignor of {obj}",
                             "ring the consignor of {obj}"],
             "direct_verbs": ["call {name}", "ring {name}"],
             "pair_verbs": ["call", "notify"],
             "decoys": [
               {"name": "textConsignor", "desc": "text a consignor re: piece",
                "child_verbs": ["text the consignor of {obj}", "send the consignor of {obj} a text"],
                "direct_verbs": ["text {name}", "send {name} a text"],
                "pair_verbs": ["text", "message"]},
               {"name": "faxConsignor", "desc": "fax a consignor re: piece",
                "child_verbs": ["fax the consignor of {obj}", "send the consignor of {obj} a fax"],
                "direct_verbs": ["fax {name}", "send {name} a fax"],
                "pair_verbs": ["fax", "send a fax to"]},
               {"name": "mailConsignor", "desc": "mail a consignor re: piece",
                "child_verbs": ["mail the consignor of {obj}", "post a letter to the consignor of {obj}"],
                "direct_verbs": ["mail {name}", "post a letter to {name}"],
                "pair_verbs": ["mail", "write to"]}]}
  },
  "v2": {
    "create": {"name": "intakeConsignment", "desc": "intake new consignment for consignor",
               "decoys": [
                 {"name": "bookAppraisal", "desc": "book new appraisal for consignor"},
                 {"name": "openLoan", "desc": "open new loan for consignor"},
                 {"name": "draftAgreement", "desc": "draft new agreement for consignor"}]},
    "list_notes": {"name": "listPieceNotes", "desc": "list notes on a piece",
                   "decoys": [
                     {"name": "listPieceBids", "desc": "list bids on a piece"},
                     {"name": "listPieceHolds", "desc": "list holds on a piece"},
                     {"name": "listPieceInquiries", "desc": "list inquiries on a piece"}]},
    "add_note": {"name": "addPieceNote", "desc": "add note to a piece, opt title",
                 "decoys": [
                   {"name": "logPieceInquiry", "desc": "log inquiry on a piece, opt title"},
                   {"name": "addWallLabel", "desc": "add wall label to a piece, opt title"},
                   {"name": "addPriceMemo", "desc": "add price memo to a piece, opt title"}]},
    "update_note": {"name": "editPieceNote", "desc": "edit a note on a piece, text + opt title",
                    "decoys": [
                      {"name": "replyPieceNote", "desc": "reply to a note on a piece, text + opt title"},
                      {"name": "resolvePieceNote", "desc": "resolve a note on a piece, text + opt title"},
                      {"name": "escalatePieceNote", "desc": "escalate a note on a piece, text + opt title"}]},
    "delete_note": {"name": "dropPieceNote", "desc": "drop a note from a piece, no undo",
                    "decoys": [
                      {"name": "redactPieceNote", "desc": "redact a note on a piece, no undo"},
                      {"name": "purgeNoteReplies", "desc": "purge replies on a piece note, no undo"},
                      {"name": "stripNoteFile", "desc": "strip file off a piece note, no undo"}]},
    "set_image": {"name": "setDisplayImage", "desc": "set display image on piece",
                  "decoys": [
                    {"name": "setConditionPhoto", "desc": "set condition photo on piece"},
                    {"name": "setSignaturePhoto", "desc": "set signature photo on piece"},
                    {"name": "setVersoPhoto", "desc": "set verso photo on piece"}]},
    "writer": {"name": "writeShortMsg", "desc": "write short msg from brief + pieces, returns text",
               "decoys": [
                 {"name": "writeWallLabel", "desc": "write wall label from brief + pieces, returns text"},
                 {"name": "writePressBlurb", "desc": "write press blurb from brief + pieces, returns text"},
                 {"name": "writeCatalogueEntry", "desc": "write catalogue entry from brief + pieces, returns text"}]},
    "image": {"name": "renderImage", "desc": "render image from prompt, opt style, returns url",
              "decoys": [
                {"name": "renderFloorplan", "desc": "render floorplan from prompt, opt style, returns url"},
                {"name": "renderMockup", "desc": "render hang mockup from prompt, opt style, returns url"},
                {"name": "renderPoster", "desc": "render poster from prompt, opt style, returns url"}]},
    "search": {"name": "searchHelpDocs", "desc": "search help docs/kb w/ question, returns best passage",
               "decoys": [
                 {"name": "searchSalesArchive", "desc": "search sales archive w/ question, returns best passage"},
                 {"name": "searchArtistFiles", "desc": "search artist files w/ question, returns best passage"},
                 {"name": "searchPriceIndex", "desc": "search price index w/ question, returns best passage"}]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the consignment listed longest ago",
    "ord_phrase": "the consignment with the {ord} oldest listing date",
    "pre_filter": {"enum_value": "listed", "phrase": "listed"}
  },
  "ambiguous": [
    {"request": ["Clear the stale listings.",
                 "The listings are piling up, fix it."],
     "hint": "pull listed consignments listed more than 60 days ago",
     "clauses": [{"enum_value": "listed"},
                 {"time_index": 0, "days": 60}],
     "action": "delete_child"},
    {"request": ["Sort out the authentication gap.",
                 "Clear the unauthenticated backlog."],
     "hint": "mark sold consignments as authenticated",
     "clauses": [{"enum_value": "sold"}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["Your consignment needs a decision.",
                   "The gallery has an update on your piece.",
                   "Your consignment listing needs review.",
                   "A buyer inquiry has come in on your piece."],
    "agg_msgs": ["You have the most pieces on consignment right now.",
                 "You're our top consignor this season.",
                 "You hold the longest-listed piece on the floor."],
    "fail_msgs": ["The consignment update failed.",
                  "That request was not processed.",
                  "The change did not save."]
  }
}
