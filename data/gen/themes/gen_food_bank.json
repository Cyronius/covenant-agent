{
  "domain": "food_bank",
  "desc_style": "clean",
  "parent": {
    "entity": "pantry",
    "noun": ["pantry", "pantries"],
    "name_style": "company",
    "contact_field": "phone"
  },
  "child": {
    "entity": "run",
    "noun": ["run", "runs"],
    "ref_field": "pantry",
    "ref_phrase": "for {name}",
    "name_field": "route",
    "titles": ["Eastside Apartments Route", "Riverside Shelter Route",
               "Downtown Senior Center Route", "North County Mobile Stop",
               "Maple Street School Route", "Harbor View Housing Route",
               "Grant Park Route", "Lincoln Elementary Route",
               "Westgate Community Center Route", "Old Mill Road Route",
               "Cedar Heights Route", "Fairview Trailer Park Route"],
    "bools": [
      {"field": "cold_chain_required", "true_phrase": "cold-chain",
       "false_phrase": "shelf-stable", "placement": "pre"},
      {"field": "volunteer_confirmed", "true_phrase": "staffed",
       "false_phrase": "unstaffed", "placement": "pre"}
    ],
    "enum": {
      "field": "phase", "values": ["scheduled", "loading", "delivered", "cancelled"],
      "phrases": {"scheduled": ["scheduled", "pre"],
                  "loading": ["loading", "pre"],
                  "delivered": ["delivered", "pre"],
                  "cancelled": ["cancelled", "pre"]}
    },
    "times": [
      {"field": "departure", "kind": "time_now",
       "lt_phrase": ["already departed", "post"],
       "gt_phrase": ["not yet departed", "post"]},
      {"field": "scheduled_at", "kind": "time_cutoff",
       "phrase": "scheduled more than {d} days ago"}
    ]
  },
  "tools": {
    "list_child": {"name": "list_runs",
                   "desc": "List every distribution run on the schedule."},
    "get_child": {"name": "get_run",
                  "desc": "Fetch one distribution run by its id."},
    "list_parent": {"name": "list_pantries",
                    "desc": "List all partner pantries in the network."},
    "get_parent": {"name": "get_pantry",
                   "desc": "Fetch one partner pantry by id."},
    "delete_child": {"name": "remove_run",
                     "desc": "Permanently remove a distribution run record. Not reversible.",
                     "verbs": ["remove {obj}", "delete {obj} from the schedule"]},
    "set_enum": {"name": "set_run_phase",
                 "desc": "Change a distribution run's phase (scheduled, loading, delivered, or cancelled).",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"scheduled": "back to scheduled",
                                   "loading": "as loading",
                                   "delivered": "as delivered",
                                   "cancelled": "as cancelled"}},
    "set_bool": {"name": "flag_cold_chain",
                 "bool_index": 0, "value": true,
                 "desc": "Flag a run as requiring cold-chain handling.",
                 "verbs": ["flag {obj} as cold-chain", "mark {obj} cold-chain"]},
    "set_ref": {"name": "reassign_pantry",
                "desc": "Move a distribution run to a different partner pantry.",
                "verbs": ["move {obj} {to_name}", "reassign {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "call_pantry",
             "desc": "Place a phone call to a partner pantry's contact.",
             "child_verbs": ["call the pantry behind {obj}",
                             "give the pantry behind {obj} a call"],
             "direct_verbs": ["call {name}", "phone {name}"],
             "pair_verbs": ["call", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the run with the earliest departure",
    "ord_phrase": "the run with the {ord} earliest departure",
    "pre_filter": {"enum_value": "scheduled", "phrase": "scheduled"}
  },
  "ambiguous": [
    {"request": ["Sort out the loading dock backlog.",
                 "The loading dock is a mess, deal with it."],
     "hint": "flag scheduled runs already past departure as cold-chain",
     "clauses": [{"enum_value": "scheduled"},
                 {"time_index": 0, "op": "LT"}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["Your run needs attention.",
                   "Please review your upcoming run.",
                   "A note about your run.",
                   "Your run may need rescheduling."],
    "agg_msgs": ["You currently top this list.",
                 "Flagging this to you directly.",
                 "You lead this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
