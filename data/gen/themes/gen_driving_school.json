{
  "domain": "driving_school",
  "desc_style": "terse",
  "parent": {
    "entity": "learner",
    "noun": ["learner", "learners"],
    "name_style": "person",
    "contact_field": "phone"
  },
  "child": {
    "entity": "lesson",
    "noun": ["lesson", "lessons"],
    "ref_field": "learner",
    "ref_phrase": "for {name}",
    "name_field": "lesson_type",
    "titles": ["Highway driving", "Parallel parking practice", "Night driving",
               "Defensive driving", "Roundabout navigation", "Three-point turn",
               "Emergency braking drill", "Freeway merging",
               "Manual transmission basics", "Road test prep",
               "Wet weather driving", "Reverse parking",
               "City traffic navigation", "Rural road driving"],
    "bools": [
      {"field": "needs_vehicle", "true_phrase": "needs a school car",
       "false_phrase": "using own car", "placement": "post"}
    ],
    "enum": {
      "field": "stage", "values": ["booked", "completed", "no_show"],
      "phrases": {"booked": ["booked", "pre"],
                  "completed": ["completed", "pre"],
                  "no_show": ["no-show", "pre"]}
    },
    "times": [
      {"field": "slot", "kind": "time_now",
       "lt_phrase": ["already passed", "post"],
       "gt_phrase": ["still upcoming", "post"]}
    ]
  },
  "tools": {
    "list_child": {"name": "lst_lsns", "desc": "list all lessons"},
    "get_child": {"name": "get_lsn", "desc": "fetch one lesson by id"},
    "list_parent": {"name": "lst_lrns", "desc": "list all learners"},
    "get_parent": {"name": "get_lrn", "desc": "fetch one learner by id"},
    "delete_child": {"name": "del_lsn",
                     "desc": "wipe a lesson rec. not reversible",
                     "verbs": ["del {obj}", "wipe {obj}"]},
    "set_enum": {"name": "set_lsn_stage",
                 "desc": "chg lesson stage",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"booked": "back to booked",
                                   "completed": "as completed",
                                   "no_show": "as a no-show"}},
    "set_bool": {"name": "flag_vehicle",
                 "bool_index": 0, "value": true,
                 "desc": "flag lesson needs school car",
                 "verbs": ["flag {obj} needs a car", "mark {obj} needs a school car"]},
    "set_ref": {"name": "move_lrn",
                "desc": "move lesson to diff learner",
                "verbs": ["move {obj} {to_name}", "reassign {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "txt_lrn",
             "desc": "text a learner",
             "child_verbs": ["text the learner in {obj}", "ping the learner on {obj}"],
             "direct_verbs": ["text {name}", "send {name} a text"],
             "pair_verbs": ["text", "ping"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the lesson with the earliest slot",
    "ord_phrase": "the lesson with the {ord} earliest slot",
    "pre_filter": {"enum_value": "booked", "phrase": "booked"}
  },
  "ambiguous": [
    {"request": ["Sort out the booking mess.", "Clean up the lesson schedule."],
     "hint": "delete lessons marked no-show whose slot already passed",
     "clauses": [{"enum_value": "no_show"},
                 {"time_index": 0, "op": "LT"}],
     "action": "delete_child"}
  ],
  "banks": {
    "child_msgs": ["Your lesson needs attention.",
                   "Please review your upcoming lesson.",
                   "A note about your lesson.",
                   "Your lesson may need rescheduling."],
    "agg_msgs": ["You currently top this list.",
                 "Flagging this to you directly.",
                 "You lead this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
