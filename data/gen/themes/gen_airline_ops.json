{
  "domain": "airline_ops",
  "desc_style": "terse",
  "parent": {
    "entity": "carrier",
    "noun": ["carrier", "carriers"],
    "name_style": "company",
    "contact_field": null
  },
  "child": {
    "entity": "segment",
    "noun": ["segment", "segments"],
    "ref_field": "carrier",
    "ref_phrase": "operated by {name}",
    "name_field": "route",
    "titles": ["JFK to LHR", "ORD to NRT", "LAX to SYD", "ATL to CDG",
               "DFW to GRU", "SEA to ICN", "MIA to EZE", "BOS to DUB",
               "SFO to HKG", "IAH to FRA", "DEN to AMS", "PHX to CUN"],
    "bools": [
      {"field": "diverted", "true_phrase": "diverted",
       "false_phrase": "on original route", "placement": "pre"}
    ],
    "enum": {
      "field": "phase", "values": ["scheduled", "boarding", "departed", "cancelled"],
      "phrases": {"scheduled": ["scheduled", "pre"],
                  "boarding": ["boarding", "pre"],
                  "departed": ["departed", "pre"],
                  "cancelled": ["cancelled", "pre"]}
    },
    "times": [
      {"field": "departure_time", "kind": "time_now",
       "lt_phrase": ["already departed", "post"],
       "gt_phrase": ["not yet departed", "post"]},
      {"field": "scheduled_on", "kind": "time_cutoff",
       "phrase": "scheduled more than {d} days ago"}
    ],
    "number": {"field": "block_minutes", "noun": "block time in minutes", "min": 45, "max": 480}
  },
  "tools": {
    "list_child": {"name": "lsSchedSeg",
                   "desc": "ls segs on ops sched",
                   "decoys": [
                     {"name": "lsDraftSeg", "desc": "ls segs on draft sched"},
                     {"name": "lsSlotSeg", "desc": "ls segs in slot filing"},
                     {"name": "lsCodeshareSeg", "desc": "ls segs on codeshare feed"}]},
    "get_child": {"name": "getSegSched",
                  "desc": "get seg sched entry by id",
                  "decoys": [
                    {"name": "getSegLoad", "desc": "get seg loadsheet by id"},
                    {"name": "getSegMx", "desc": "get seg mx rec by id"},
                    {"name": "getSegWx", "desc": "get seg wx brief by id"}]},
    "list_parent": {"name": "lsRosterCarrier",
                    "desc": "ls carriers in ops roster",
                    "decoys": [
                      {"name": "lsAllianceCarrier", "desc": "ls carriers in alliance group"},
                      {"name": "lsInterlineCarrier", "desc": "ls carriers in interline pact"},
                      {"name": "lsLeaseCarrier", "desc": "ls carriers in lease pool"}]},
    "get_parent": {"name": "getCarrierFile",
                   "desc": "get carrier file by id",
                   "decoys": [
                     {"name": "getCarrierFleet", "desc": "get carrier fleet list by id"},
                     {"name": "getCarrierOtp", "desc": "get carrier otp rec by id"},
                     {"name": "getCarrierAoc", "desc": "get carrier aoc by id"}]},
    "delete_child": {"name": "purgeSegSched",
                     "desc": "purge seg from sched, no undo",
                     "verbs": ["delete {obj}", "wipe {obj} from the schedule"],
                     "decoys": [
                       {"name": "delSegPax", "desc": "del pax rec from seg, no undo",
                        "verbs": ["delete the pax list on {obj}", "clear the pax off {obj}"]},
                       {"name": "voidSegFares", "desc": "void fares on seg, no undo",
                        "verbs": ["void the fares on {obj}", "kill the fares for {obj}"]},
                       {"name": "scrapSegCrew", "desc": "scrap crew on seg, no undo",
                        "verbs": ["scrap the crew pairing on {obj}", "drop the crew for {obj}"]}]},
    "set_enum": {"name": "setSegPhase",
                 "desc": "set seg phase: scheduled/boarding/departed/cancelled",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"scheduled": "back to scheduled", "boarding": "as boarding", "departed": "as departed", "cancelled": "as cancelled"},
                 "decoys": [
                   {"name": "setSegTarget", "desc": "set seg target: scheduled/boarding/departed/cancelled"},
                   {"name": "queueSegPhase", "desc": "queue seg phase: scheduled/boarding/departed/cancelled"},
                   {"name": "fcstSegPhase", "desc": "fcst seg phase: scheduled/boarding/departed/cancelled"}]},
    "set_bool": {"name": "flagDiverted",
                 "bool_index": 0,
                 "value": true,
                 "desc": "flag seg as diverted",
                 "verbs": ["flag {obj} as diverted", "mark {obj} diverted"],
                 "decoys": [
                   {"name": "flagOversold", "desc": "flag seg as oversold",
                    "verbs": ["flag {obj} as oversold", "mark {obj} oversold"]},
                   {"name": "flagDelayed", "desc": "flag seg as delayed",
                    "verbs": ["flag {obj} as delayed", "mark {obj} delayed"]},
                   {"name": "flagOverweight", "desc": "flag seg as overweight",
                    "verbs": ["flag {obj} as overweight", "mark {obj} weight-restricted"]}]},
    "set_ref": {"name": "moveSegOps",
                "desc": "move seg ops to diff carrier",
                "verbs": ["move {obj} {to_name}", "reassign {obj} {to_name}"],
                "to_template": "to {name}",
                "decoys": [
                  {"name": "moveSegFares", "desc": "move seg fares to diff carrier",
                   "verbs": ["move the fares on {obj} {to_name}", "hand fare filing for {obj} {to_name}"]},
                  {"name": "moveSegHandling", "desc": "move seg handling to diff carrier",
                   "verbs": ["move ground handling for {obj} {to_name}", "give handling on {obj} {to_name}"]},
                  {"name": "moveSegCrew", "desc": "move seg crewing to diff carrier",
                   "verbs": ["move the crewing on {obj} {to_name}", "hand crew supply for {obj} {to_name}"]}]},
    "send": {"name": "notifyCarrier",
             "desc": "send notice to carrier ops",
             "child_verbs": ["notify the carrier of {obj}", "ping the carrier of {obj}"],
             "direct_verbs": ["notify {name}", "ping {name}"],
             "pair_verbs": ["notify", "ping"],
             "decoys": [
               {"name": "billCarrier", "desc": "send bill to carrier ops",
                "child_verbs": ["bill the carrier of {obj}", "send an invoice to the carrier of {obj}"],
                "direct_verbs": ["bill {name}", "send {name} an invoice"],
                "pair_verbs": ["bill", "invoice"]},
               {"name": "claimCarrier", "desc": "send claim to carrier ops",
                "child_verbs": ["file a claim with the carrier of {obj}", "send a claim to the carrier of {obj}"],
                "direct_verbs": ["file a claim with {name}", "send {name} a claim"],
                "pair_verbs": ["file a claim with", "claim against"]},
               {"name": "reportCarrier", "desc": "send irop rpt to carrier ops",
                "child_verbs": ["send an irop report to the carrier of {obj}", "file an irop report with the carrier of {obj}"],
                "direct_verbs": ["send {name} an irop report", "file an irop report with {name}"],
                "pair_verbs": ["report to", "file an irop report with"]}]}
  },
  "v2": {
    "create": {"name": "newSeg",
               "desc": "new seg for a carrier",
               "decoys": [
                 {"name": "draftSeg", "desc": "draft seg for a carrier"},
                 {"name": "fileSeg", "desc": "file seg for a carrier"},
                 {"name": "quoteSeg", "desc": "quote seg for a carrier"}]},
    "list_notes": {"name": "lsSegRemarks",
                   "desc": "ls remarks on one seg",
                   "decoys": [
                     {"name": "lsSegNotams", "desc": "ls notams on one seg"},
                     {"name": "lsSegPireps", "desc": "ls pireps on one seg"},
                     {"name": "lsRemarkAcks", "desc": "ls remark acks on one seg"}]},
    "add_note": {"name": "addSegRemark",
                 "desc": "add remark to seg",
                 "decoys": [
                   {"name": "draftSegRemark", "desc": "draft remark on seg"},
                   {"name": "addSegPirep", "desc": "add pirep to seg"},
                   {"name": "addSegSquawk", "desc": "add squawk to seg"}]},
    "update_note": {"name": "editSegRemark",
                    "desc": "edit seg remark text (+ title opt)",
                    "decoys": [
                      {"name": "editSegPirep", "desc": "edit seg pirep text (+ title opt)"},
                      {"name": "editSegSquawk", "desc": "edit seg squawk text (+ title opt)"},
                      {"name": "replySegRemark", "desc": "reply to seg remark (+ title opt)"}]},
    "delete_note": {"name": "rmSegRemark",
                    "desc": "rm remark from seg",
                    "decoys": [
                      {"name": "rmSegPirep", "desc": "rm pirep from seg"},
                      {"name": "redactSegRemark", "desc": "redact remark on seg"},
                      {"name": "cxlSegNotam", "desc": "cxl notam on seg"}]},
    "set_image": {"name": "setSegHeader",
                  "desc": "set seg header img",
                  "decoys": [
                    {"name": "setSegMap", "desc": "set seg map img"},
                    {"name": "setSegSeatmap", "desc": "set seg seatmap img"},
                    {"name": "setSegLivery", "desc": "set seg livery img"}]},
    "writer": {"name": "writeShortTxt",
               "desc": "write quick txt from brief + segs, returns txt",
               "decoys": [
                 {"name": "writeCrewBriefing", "desc": "write crew briefing from brief + segs, returns txt"},
                 {"name": "writePaxNotice", "desc": "write short pax notice from brief + segs, returns txt"},
                 {"name": "writeDispatchRelease", "desc": "write dispatch release from brief + segs, returns txt"}]},
    "image": {"name": "genCustomImg",
              "desc": "gen custom img from prompt, returns url",
              "decoys": [
                {"name": "genLiveryImg", "desc": "gen livery img from prompt, returns url"},
                {"name": "genMapImg", "desc": "gen map img from prompt, returns url"},
                {"name": "genChartImg", "desc": "gen chart img from prompt, returns url"}]},
    "search": {"name": "searchSysDocs",
               "desc": "search sys docs + kb w/ question, returns best passage",
               "decoys": [
                 {"name": "searchOpsDocs", "desc": "search flight ops docs w/ question, returns best passage"},
                 {"name": "searchMelCdl", "desc": "search mel + cdl w/ question, returns best passage"},
                 {"name": "searchApiDocs", "desc": "search api docs w/ question, returns best passage"}]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the segment with the earliest departure time",
    "ord_phrase": "the segment with the {ord} earliest departure time",
    "pre_filter": {"enum_value": "scheduled", "phrase": "scheduled"}
  },
  "ambiguous": [
    {"request": ["Clear the dead segments.", "The schedule's a mess, fix it."],
     "hint": "delete segments still scheduled and already past departure",
     "clauses": [{"enum_value": "scheduled"},
                 {"time_index": 0, "op": "LT"}],
     "action": "delete_child"},
    {"request": ["Handle the ones booked ages ago and never touched.", "Sort out the stale schedule entries."],
     "hint": "flag as diverted segments still scheduled and scheduled more than 90 days ago",
     "clauses": [{"enum_value": "scheduled"},
                 {"time_index": 1, "days": 90}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["Your flight segment needs attention.",
                   "Please review this segment.",
                   "A note about your flight segment.",
                   "Your segment may need rebooking."],
    "agg_msgs": ["You currently top this list.",
                 "Flagging this segment to you directly.",
                 "You lead this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
