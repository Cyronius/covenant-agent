{
  "domain": "airline_ops",
  "desc_style": "terse",
  "parent": {
    "entity": "carrier",
    "noun": ["carrier", "carriers"],
    "name_style": "company",
    "contact_field": null
  },
  "child": {
    "entity": "segment",
    "noun": ["segment", "segments"],
    "ref_field": "carrier",
    "ref_phrase": "operated by {name}",
    "name_field": "route",
    "titles": ["JFK to LHR", "ORD to NRT", "LAX to SYD", "ATL to CDG",
               "DFW to GRU", "SEA to ICN", "MIA to EZE", "BOS to DUB",
               "SFO to HKG", "IAH to FRA", "DEN to AMS", "PHX to CUN"],
    "bools": [
      {"field": "diverted", "true_phrase": "diverted",
       "false_phrase": "on original route", "placement": "pre"}
    ],
    "enum": {
      "field": "phase", "values": ["scheduled", "boarding", "departed", "cancelled"],
      "phrases": {"scheduled": ["scheduled", "pre"],
                  "boarding": ["boarding", "pre"],
                  "departed": ["departed", "pre"],
                  "cancelled": ["cancelled", "pre"]}
    },
    "times": [
      {"field": "departure_time", "kind": "time_now",
       "lt_phrase": ["already departed", "post"],
       "gt_phrase": ["not yet departed", "post"]},
      {"field": "scheduled_on", "kind": "time_cutoff",
       "phrase": "scheduled more than {d} days ago"}
    ]
  },
  "tools": {
    "list_child": {"name": "lsSeg",
                   "desc": "ls all segs"},
    "get_child": {"name": "getSeg",
                  "desc": "get one seg by id"},
    "list_parent": {"name": "lsCarrier",
                    "desc": "ls all carriers"},
    "get_parent": {"name": "getCarrier",
                   "desc": "get one carrier by id"},
    "delete_child": {"name": "delSeg",
                     "desc": "del seg rec, no undo",
                     "verbs": ["delete {obj}", "wipe {obj} from the schedule"]},
    "set_enum": {"name": "setSegPhase",
                 "desc": "set seg phase: scheduled/boarding/departed/cancelled",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"scheduled": "back to scheduled",
                                   "boarding": "as boarding",
                                   "departed": "as departed",
                                   "cancelled": "as cancelled"}},
    "set_bool": {"name": "flagDivert",
                 "bool_index": 0, "value": true,
                 "desc": "flag seg as diverted",
                 "verbs": ["flag {obj} as diverted", "mark {obj} diverted"]},
    "set_ref": {"name": "reassignCarrier",
                "desc": "move seg to a diff carrier",
                "verbs": ["move {obj} {to_name}", "reassign {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "notifyCarrier",
             "desc": "send msg to carrier ops",
             "child_verbs": ["notify the carrier of {obj}",
                             "ping the carrier of {obj}"],
             "direct_verbs": ["notify {name}", "ping {name}"],
             "pair_verbs": ["notify", "ping"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the segment with the earliest departure time",
    "ord_phrase": "the segment with the {ord} earliest departure time",
    "pre_filter": {"enum_value": "scheduled", "phrase": "scheduled"}
  },
  "ambiguous": [
    {"request": ["Clear the dead segments.", "The schedule's a mess, fix it."],
     "hint": "delete segments still scheduled and already past departure",
     "clauses": [{"enum_value": "scheduled"},
                 {"time_index": 0, "op": "LT"}],
     "action": "delete_child"},
    {"request": ["Handle the ones booked ages ago and never touched.", "Sort out the stale schedule entries."],
     "hint": "flag as diverted segments still scheduled and scheduled more than 90 days ago",
     "clauses": [{"enum_value": "scheduled"},
                 {"time_index": 1, "days": 90}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["Your flight segment needs attention.",
                   "Please review this segment.",
                   "A note about your flight segment.",
                   "Your segment may need rebooking."],
    "agg_msgs": ["You currently top this list.",
                 "Flagging this segment to you directly.",
                 "You lead this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
