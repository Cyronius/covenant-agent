{
  "domain": "bus_depot",
  "desc_style": "terse",
  "parent": {
    "entity": "driver",
    "noun": ["driver", "drivers"],
    "name_style": "person",
    "contact_field": "email"
  },
  "child": {
    "entity": "run",
    "noun": ["run", "runs"],
    "ref_field": "driver",
    "ref_phrase": "driven by {name}",
    "name_field": "route",
    "titles": ["Route 12 Downtown Loop", "Route 4 Airport Express", "Route 30 University Line",
               "Route 7 Riverside", "Route 21 Crosstown", "Route 55 Night Owl",
               "Route 9 Hospital Shuttle", "Route 18 Industrial Park", "Route 2 Main Street",
               "Route 44 Suburban Loop", "Route 66 Express", "Route 15 School Special"],
    "bools": [
      {"field": "overcrowded", "true_phrase": "over capacity",
       "false_phrase": "within capacity", "placement": "post"},
      {"field": "wheelchair_lift", "true_phrase": "lift-equipped",
       "false_phrase": "no lift", "placement": "pre"}
    ],
    "enum": {
      "field": "state", "values": ["scheduled", "in_service", "completed", "cancelled"],
      "phrases": {"scheduled": ["scheduled", "pre"],
                  "in_service": ["in service", "pre"],
                  "completed": ["completed", "pre"],
                  "cancelled": ["cancelled", "pre"]}
    },
    "times": [
      {"field": "depart", "kind": "time_now",
       "lt_phrase": ["already departed", "post"],
       "gt_phrase": ["not yet departed", "post"]},
      {"field": "scheduled_at", "kind": "time_cutoff",
       "phrase": "scheduled more than {d} days ago"}
    ],
    "number": {"field": "route_miles", "noun": "route distance in miles", "min": 4, "max": 60}
  },
  "tools": {
    "list_child": {"name": "list_run_board", "desc": "list all runs on run board",
                   "decoys": [
                     {"name": "list_pullout_sheet", "desc": "list all runs on pullout sheet"},
                     {"name": "list_detour_log", "desc": "list all runs on detour log"},
                     {"name": "list_fuel_log", "desc": "list all runs on fuel log"}]},
    "get_child": {"name": "get_run_card", "desc": "get run card by id",
                  "decoys": [
                    {"name": "get_run_log", "desc": "get run log by id"},
                    {"name": "get_fare_tally", "desc": "get fare tally by id"},
                    {"name": "get_defect_card", "desc": "get defect card by id"}]},
    "list_parent": {"name": "list_depot_roster", "desc": "list drivers on depot roster",
                    "decoys": [
                      {"name": "list_extra_board", "desc": "list drivers on extra board"},
                      {"name": "list_bid_sheet", "desc": "list drivers on bid sheet"},
                      {"name": "list_sick_book", "desc": "list drivers on sick book"}]},
    "get_parent": {"name": "get_driver_file", "desc": "get driver file by id",
                   "decoys": [
                     {"name": "get_driver_timecard", "desc": "get driver timecard by id"},
                     {"name": "get_driver_cdl", "desc": "get driver cdl by id"},
                     {"name": "get_driver_incidents", "desc": "get driver incidents by id"}]},
    "delete_child": {"name": "scrap_run_rec",
                     "desc": "scrap run rec, no undo",
                     "verbs": ["scrap {obj}", "drop {obj} from the board"],
                     "decoys": [
                       {"name": "void_run_fares", "desc": "void run fare rec, no undo",
                        "verbs": ["void the fares on {obj}", "zero out the fare rec for {obj}"]},
                       {"name": "wipe_run_log", "desc": "wipe run log rec, no undo",
                        "verbs": ["wipe the log on {obj}", "clear the run log for {obj}"]},
                       {"name": "purge_run_gps", "desc": "purge run gps rec, no undo",
                        "verbs": ["purge the gps trail on {obj}", "wipe the gps data for {obj}"]}]},
    "set_enum": {"name": "set_run_state",
                 "desc": "chg run state on board",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"scheduled": "back to scheduled",
                                   "in_service": "as in service",
                                   "completed": "as completed",
                                   "cancelled": "as cancelled"},
                 "decoys": [
                   {"name": "sched_run_state", "desc": "sched run state chg"},
                   {"name": "req_run_state", "desc": "req run state chg"},
                   {"name": "alert_run_state", "desc": "set run state alert"}]},
    "set_bool": {"name": "flag_overcrowded",
                 "bool_index": 0, "value": true,
                 "desc": "flag run overcrowded",
                 "verbs": ["flag {obj} overcrowded", "mark {obj} over capacity"],
                 "decoys": [
                   {"name": "flag_detoured", "desc": "flag run detoured",
                    "verbs": ["flag {obj} detoured", "mark {obj} on detour"]},
                   {"name": "flag_curtailed", "desc": "flag run curtailed",
                    "verbs": ["flag {obj} curtailed", "mark {obj} cut short"]},
                   {"name": "flag_inspected", "desc": "flag run inspected",
                    "verbs": ["flag {obj} inspected", "mark {obj} as inspected"]}]},
    "set_ref": {"name": "reassign_driver",
                "desc": "move run to another driver",
                "verbs": ["reassign {obj} {to_name}", "move {obj} {to_name}"],
                "to_template": "to {name}",
                "decoys": [
                  {"name": "offer_driver", "desc": "offer run to another driver",
                   "verbs": ["offer {obj} {to_name}", "put {obj} up as open work {to_name}"]},
                  {"name": "award_driver", "desc": "award run bid to another driver",
                   "verbs": ["award {obj} {to_name}", "award the bid on {obj} {to_name}"]},
                  {"name": "send_paddle", "desc": "send run paddle to other driver",
                   "verbs": ["send the paddle for {obj} {to_name}", "pass the paddle on {obj} {to_name}"]}]},
    "send": {"name": "page_driver",
             "desc": "page driver w/ msg",
             "child_verbs": ["page the driver of {obj}", "ping the driver of {obj}"],
             "direct_verbs": ["page {name}", "ping {name}"],
             "pair_verbs": ["page", "ping"],
             "decoys": [
               {"name": "email_driver", "desc": "email driver w/ msg",
                "child_verbs": ["email the driver of {obj}", "send the driver of {obj} an email"],
                "direct_verbs": ["email {name}", "send {name} an email"],
                "pair_verbs": ["email", "mail"]},
               {"name": "radio_driver", "desc": "radio driver w/ msg",
                "child_verbs": ["radio the driver of {obj}", "get the driver of {obj} on the radio"],
                "direct_verbs": ["radio {name}", "get {name} on the radio"],
                "pair_verbs": ["radio", "call"]},
               {"name": "text_driver", "desc": "text driver w/ msg",
                "child_verbs": ["text the driver of {obj}", "send the driver of {obj} a text"],
                "direct_verbs": ["text {name}", "send {name} a text"],
                "pair_verbs": ["text", "send a text to"]}]}
  },
  "v2": {
    "create": {"name": "add_run", "desc": "add new run for driver",
               "decoys": [
                 {"name": "add_charter", "desc": "add new charter for driver"},
                 {"name": "add_pretrip", "desc": "add new pretrip for driver"},
                 {"name": "add_timecard", "desc": "add new timecard for driver"}]},
    "list_notes": {"name": "list_run_notes", "desc": "list notes on a run",
                   "decoys": [
                     {"name": "list_run_defects", "desc": "list defects on a run"},
                     {"name": "list_run_incidents", "desc": "list incidents on a run"},
                     {"name": "list_run_detours", "desc": "list detours on a run"}]},
    "add_note": {"name": "add_run_note", "desc": "add note to run, opt title",
                 "decoys": [
                   {"name": "add_run_defect", "desc": "add defect to run, opt title"},
                   {"name": "add_run_incident", "desc": "add incident to run, opt title"},
                   {"name": "add_run_complaint", "desc": "add complaint to run, opt title"}]},
    "update_note": {"name": "edit_run_note", "desc": "edit note on run, text + opt title",
                    "decoys": [
                      {"name": "reply_run_note", "desc": "reply to note on run, text + opt title"},
                      {"name": "close_run_note", "desc": "close note on run, text + opt title"},
                      {"name": "escalate_run_note", "desc": "escalate note on run, text + opt title"}]},
    "delete_note": {"name": "del_run_note", "desc": "del a note on run, no undo",
                    "decoys": [
                      {"name": "redact_run_note", "desc": "redact a note on run, no undo"},
                      {"name": "purge_note_replies", "desc": "purge a note's replies, no undo"},
                      {"name": "strip_note_file", "desc": "strip file off run note, no undo"}]},
    "set_image": {"name": "set_run_image", "desc": "set display image on run",
                  "decoys": [
                    {"name": "set_damage_photo", "desc": "set damage photo on run"},
                    {"name": "set_route_map", "desc": "set route map on run"},
                    {"name": "set_dashcam_still", "desc": "set dashcam still on run"}]},
    "writer": {"name": "write_short_msg", "desc": "write short msg from brief + runs, returns text",
               "decoys": [
                 {"name": "write_rider_alert", "desc": "write rider alert from brief + runs, returns text"},
                 {"name": "write_incident_rpt", "desc": "write incident rpt from brief + runs, returns text"},
                 {"name": "write_shift_rpt", "desc": "write shift rpt from brief + runs, returns text"}]},
    "image": {"name": "gen_image", "desc": "gen image from prompt, opt style, returns url",
              "decoys": [
                {"name": "gen_map", "desc": "gen route map from prompt, opt style, returns url"},
                {"name": "gen_poster", "desc": "gen rider poster from prompt, opt style, returns url"},
                {"name": "gen_diagram", "desc": "gen bay diagram from prompt, opt style, returns url"}]},
    "search": {"name": "search_help", "desc": "search help docs/kb w/ q, returns best passage",
               "decoys": [
                 {"name": "search_rulebook", "desc": "search operator rulebook w/ q, returns best passage"},
                 {"name": "search_timetables", "desc": "search timetables w/ q, returns best passage"},
                 {"name": "search_bulletins", "desc": "search service bulletins w/ q, returns best passage"}]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the run with the earliest departure",
    "ord_phrase": "the run with the {ord} earliest departure",
    "pre_filter": {"enum_value": "scheduled", "phrase": "scheduled"}
  },
  "ambiguous": [
    {"request": ["Flag anything running full.",
                 "Deal with the packed runs."],
     "hint": "flag scheduled runs as overcrowded",
     "clauses": [{"enum_value": "scheduled"}],
     "action": "set_bool"},
    {"request": ["Clean up the run board.",
                 "Board's a mess, sort it."],
     "hint": "scrap cancelled runs scheduled more than a set number of days ago",
     "clauses": [{"enum_value": "cancelled"},
                 {"time_index": 1, "days": 14}],
     "action": "delete_child"}
  ],
  "banks": {
    "child_msgs": ["run needs attention",
                   "check run status",
                   "note on your run",
                   "run may be delayed"],
    "agg_msgs": ["you top this list",
                 "flagging to you direct",
                 "you lead this count"],
    "fail_msgs": ["op failed",
                  "action not completed",
                  "last op failed"]
  }
}
