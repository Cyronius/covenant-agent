{
  "domain": "sports_league",
  "desc_style": "clean",
  "parent": {
    "entity": "club",
    "noun": ["club", "clubs"],
    "name_style": "company",
    "contact_field": "email"
  },
  "child": {
    "entity": "fixture",
    "noun": ["fixture", "fixtures"],
    "ref_field": "club",
    "ref_phrase": "for {name}",
    "name_field": "matchup",
    "titles": ["Riverside United vs Ashfield Rovers", "Kingsmead Town vs Portbridge FC",
               "Oakvale Athletic vs Bramwell City", "Sutton Harbour vs Millfield Wanderers",
               "Dunbar Rangers vs Castlegate United", "Northwood FC vs Silverdale Town",
               "Eastfield Albion vs Redcliff Rovers", "Greenmoor United vs Halston City",
               "Fenwick Athletic vs Corby Vale", "Ashgrove Rangers vs Marlow Town",
               "Westbrook FC vs Underhill United", "Bellfield Rovers vs Thorncastle City"],
    "bools": [
      {"field": "televised", "true_phrase": "televised",
       "false_phrase": "not televised", "placement": "pre"},
      {"field": "derby_match", "true_phrase": "local derby",
       "false_phrase": "non-derby", "placement": "post"}
    ],
    "enum": {
      "field": "status", "values": ["scheduled", "played", "postponed"],
      "phrases": {"scheduled": ["upcoming", "pre"],
                  "played": ["played", "pre"],
                  "postponed": ["postponed", "pre"]}
    },
    "times": [
      {"field": "kickoff", "kind": "time_now",
       "lt_phrase": ["already kicked off", "post"],
       "gt_phrase": ["still to come", "post"]},
      {"field": "rescheduled_at", "kind": "time_cutoff",
       "phrase": "rescheduled more than {d} days ago"}
    ]
  },
  "tools": {
    "list_child": {"name": "list_fixtures",
                   "desc": "List every fixture on the league calendar."},
    "get_child": {"name": "get_fixture",
                  "desc": "Fetch one fixture by its id."},
    "list_parent": {"name": "list_clubs",
                    "desc": "List every club registered with the league."},
    "get_parent": {"name": "get_club",
                   "desc": "Fetch one club by id."},
    "delete_child": {"name": "cancel_fixture",
                     "desc": "Permanently remove a fixture from the calendar. Not reversible.",
                     "verbs": ["cancel {obj}", "scratch {obj} from the calendar"]},
    "set_enum": {"name": "set_fixture_status",
                 "desc": "Change a fixture's status (scheduled, played, or postponed).",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"scheduled": "back to scheduled",
                                   "played": "as played",
                                   "postponed": "as postponed"}},
    "set_bool": {"name": "flag_televised",
                 "bool_index": 0, "value": true,
                 "desc": "Flag a fixture as televised.",
                 "verbs": ["flag {obj} as televised", "mark {obj} for broadcast"]},
    "set_ref": {"name": "reassign_home_club",
                "desc": "Move a fixture to a different home club.",
                "verbs": ["move {obj} {to_name}", "reassign {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "email_club",
             "desc": "Send an email to a club.",
             "child_verbs": ["email the club hosting {obj}",
                             "notify the club behind {obj}"],
             "direct_verbs": ["email {name}", "send {name} a note"],
             "pair_verbs": ["email", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the fixture with the earliest kickoff",
    "ord_phrase": "the fixture with the {ord} earliest kickoff",
    "pre_filter": {"enum_value": "scheduled", "phrase": "scheduled"}
  },
  "ambiguous": [
    {"request": ["Clear out the fixture backlog.",
                 "The calendar's a mess, sort it."],
     "hint": "cancel scheduled fixtures already past kickoff",
     "clauses": [{"enum_value": "scheduled"},
                 {"time_index": 0, "op": "LT"}],
     "action": "delete_child"},
    {"request": ["Deal with the broadcast list.",
                 "Handle the TV fixtures that need flagging."],
     "hint": "flag scheduled fixtures already past kickoff as televised",
     "clauses": [{"enum_value": "scheduled"},
                 {"time_index": 0, "op": "LT"}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["Your club has a fixture that needs attention.",
                   "Please review your upcoming fixture.",
                   "A note about your fixture.",
                   "Your fixture may need rescheduling."],
    "agg_msgs": ["Your club tops this list.",
                 "Flagging this to your club directly.",
                 "Your club leads this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
