{
  "domain": "jewelry_workshop",
  "desc_style": "clean",
  "parent": {
    "entity": "patron",
    "noun": ["patron", "patrons"],
    "name_style": "person",
    "contact_field": "email"
  },
  "child": {
    "entity": "commission",
    "noun": ["commission", "commissions"],
    "ref_field": "patron",
    "ref_phrase": "for {name}",
    "name_field": "piece",
    "titles": ["Engagement ring resize", "Custom wedding band",
               "Pendant with birthstone", "Signet ring engraving",
               "Bracelet chain repair", "Earring setting rebuild",
               "Necklace clasp replacement", "Cufflink monogram",
               "Tennis bracelet restring", "Brooch restoration",
               "Anniversary band inlay", "Charm bracelet addition"],
    "bools": [
      {"field": "rush", "true_phrase": "rush",
       "false_phrase": "standard", "placement": "pre"}
    ],
    "enum": {
      "field": "stage", "values": ["design", "casting", "setting", "polished"],
      "phrases": {"design": ["in design", "pre"],
                  "casting": ["in casting", "pre"],
                  "setting": ["in stone-setting", "post"],
                  "polished": ["polished", "pre"]}
    },
    "times": [
      {"field": "due", "kind": "time_now",
       "lt_phrase": ["past due", "post"],
       "gt_phrase": ["not yet due", "post"]}
    ]
  },
  "tools": {
    "list_child": {"name": "listCommissions",
                   "desc": "List every custom commission in the workshop."},
    "get_child": {"name": "getCommission",
                  "desc": "Fetch one commission by its id."},
    "list_parent": {"name": "listPatrons",
                    "desc": "List all patrons who have commissioned work."},
    "get_parent": {"name": "getPatron",
                   "desc": "Fetch one patron by id."},
    "delete_child": {"name": "deleteCommission",
                     "desc": "Permanently remove a commission record. Not reversible.",
                     "verbs": ["delete {obj}", "scrap {obj}"]},
    "set_enum": {"name": "setCommissionStage",
                 "desc": "Change a commission's stage (design, casting, setting, or polished).",
                 "verbs": ["move {obj} {to_value}", "advance {obj} {to_value}"],
                 "value_phrases": {"design": "back to design",
                                   "casting": "to casting",
                                   "setting": "to stone-setting",
                                   "polished": "to polished"}},
    "set_bool": {"name": "flagRush",
                 "bool_index": 0, "value": true,
                 "desc": "Flag a commission as a rush order.",
                 "verbs": ["flag {obj} as rush", "mark {obj} rush"]},
    "set_ref": {"name": "reassignPatron",
                "desc": "Move a commission to a different patron's account.",
                "verbs": ["move {obj} {to_name}", "reassign {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "emailPatron",
             "desc": "Send an email to a patron.",
             "child_verbs": ["email the patron for {obj}",
                             "notify the patron for {obj}"],
             "direct_verbs": ["email {name}", "notify {name}"],
             "pair_verbs": ["email", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the commission with the earliest due date",
    "ord_phrase": "the commission with the {ord} earliest due date",
    "pre_filter": {"enum_value": "design", "phrase": "in design"}
  },
  "ambiguous": [
    {"request": ["Clear out the stale designs.",
                 "The design queue needs sorting."],
     "hint": "delete design-stage commissions already past due",
     "clauses": [{"enum_value": "design"},
                 {"time_index": 0, "op": "LT"}],
     "action": "delete_child"},
    {"request": ["Flag the urgent ones.",
                 "Sort out what's overdue."],
     "hint": "flag design-stage commissions already past due as rush",
     "clauses": [{"enum_value": "design"},
                 {"time_index": 0, "op": "LT"}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["Your commission needs a look.",
                   "Please check on your custom piece.",
                   "A note about your commission.",
                   "Your commission may need your input."],
    "agg_msgs": ["You have the most open commissions right now.",
                 "Flagging this backlog to you directly.",
                 "You lead this patron's commission count."],
    "fail_msgs": ["The requested operation failed.",
                  "That update could not be completed.",
                  "The last change did not go through."]
  }
}
