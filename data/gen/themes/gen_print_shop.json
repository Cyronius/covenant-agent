{
  "domain": "print_shop",
  "desc_style": "terse",
  "parent": {
    "entity": "customer",
    "noun": ["customer", "customers"],
    "name_style": "company",
    "contact_field": "phone"
  },
  "child": {
    "entity": "print_job",
    "noun": ["print job", "print jobs"],
    "ref_field": "customer",
    "ref_phrase": "for {name}",
    "name_field": "job_type",
    "titles": ["Business Cards", "Wedding Invitations", "Trade Show Banner",
               "Vehicle Wrap", "Real Estate Yard Signs", "Menu Reprint",
               "Event Posters", "Direct Mail Postcards", "Storefront Decal",
               "Booklet Printing", "Custom T-Shirt Order", "Vinyl Banner",
               "Letterhead Run", "Trifold Brochures"],
    "bools": [
      {"field": "rush", "true_phrase": "rush",
       "false_phrase": "standard", "placement": "pre"},
      {"field": "proof_approved", "true_phrase": "proof approved",
       "false_phrase": "proof pending", "placement": "post"},
      {"field": "large_format", "true_phrase": "large-format",
       "false_phrase": "standard-format", "placement": "pre"}
    ],
    "enum": {
      "field": "phase", "values": ["quoted", "in_production", "proofing", "completed"],
      "phrases": {"quoted": ["quoted", "pre"],
                  "in_production": ["in production", "post"],
                  "proofing": ["in proofing", "post"],
                  "completed": ["completed", "pre"]}
    },
    "times": [
      {"field": "due_date", "kind": "time_now",
       "lt_phrase": ["overdue", "post"],
       "gt_phrase": ["not due yet", "post"]},
      {"field": "quoted_on", "kind": "time_cutoff",
       "phrase": "quoted more than {d} days ago"}
    ]
  },
  "tools": {
    "list_child": {"name": "lst_jobs",
                   "desc": "list all print jobs"},
    "get_child": {"name": "get_job",
                  "desc": "fetch one job by id"},
    "list_parent": {"name": "lst_cust",
                    "desc": "list all customers"},
    "get_parent": {"name": "get_cust",
                   "desc": "fetch one customer by id"},
    "delete_child": {"name": "rm_job",
                     "desc": "wipe a job rec, no undo",
                     "verbs": ["delete {obj}", "clear {obj} from the queue"]},
    "set_enum": {"name": "set_job_phs",
                 "desc": "change job phase (quoted/production/proofing/done)",
                 "verbs": ["move {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"quoted": "back to quoted",
                                   "in_production": "into production",
                                   "proofing": "into proofing",
                                   "completed": "to completed"}},
    "set_bool": {"name": "flag_rush",
                 "bool_index": 0, "value": true,
                 "desc": "mark a job rush priority",
                 "verbs": ["flag {obj} as rush", "mark {obj} rush"]},
    "set_ref": {"name": "mv_cust",
                "desc": "move a job to a different customer acct",
                "verbs": ["move {obj} {to_name}", "reassign {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "call_cust",
             "desc": "call the customer on file",
             "child_verbs": ["call the customer for {obj}",
                             "ring the customer behind {obj}"],
             "direct_verbs": ["call {name}", "ring {name}"],
             "pair_verbs": ["call", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the print job with the earliest due date",
    "ord_phrase": "the print job with the {ord} earliest due date",
    "pre_filter": {"enum_value": "in_production", "phrase": "in production"}
  },
  "ambiguous": [
    {"request": ["Sort out the overdue queue.",
                 "The queue's a mess, deal with the late ones."],
     "hint": "flag in-production jobs already past their due date as rush",
     "clauses": [{"enum_value": "in_production"},
                 {"time_index": 0, "op": "LT"}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["your print job needs a look",
                   "quick check on your job status",
                   "a note about your print job",
                   "your job may need proofing"],
    "agg_msgs": ["you're first on this list",
                 "flagging this job to you directly",
                 "you lead this count right now"],
    "fail_msgs": ["update failed",
                  "that action didn't go through",
                  "last change didn't save"]
  }
}
