{
  "domain": "fire_department",
  "desc_style": "terse",
  "parent": {
    "entity": "proprietor",
    "noun": ["proprietor", "proprietors"],
    "name_style": "company",
    "contact_field": "phone"
  },
  "child": {
    "entity": "inspection",
    "noun": ["inspection", "inspections"],
    "ref_field": "proprietor",
    "ref_phrase": "for {name}",
    "name_field": "inspection_type",
    "titles": ["Annual fire safety inspection", "Sprinkler system test", "Fire alarm certification",
               "Occupancy load review", "Emergency exit clearance check", "Extinguisher servicing check",
               "Hazardous materials storage review", "Kitchen suppression system test",
               "Electrical panel safety check", "Smoke detector compliance check",
               "Fire lane access inspection", "Re-inspection after violation"],
    "bools": [
      {"field": "violation_found", "true_phrase": "cited",
       "false_phrase": "clean", "placement": "pre"},
      {"field": "reinspection_required", "true_phrase": "needs reinspection",
       "false_phrase": "closed out", "placement": "post"},
      {"field": "occupied_during_visit", "true_phrase": "occupied",
       "false_phrase": "vacant", "placement": "pre"}
    ],
    "enum": {
      "field": "outcome", "values": ["scheduled", "passed", "failed", "corrected"],
      "phrases": {"scheduled": ["scheduled", "pre"],
                  "passed": ["passed", "pre"],
                  "failed": ["failed", "pre"],
                  "corrected": ["corrected", "pre"]}
    },
    "times": [
      {"field": "visit_date", "kind": "time_now",
       "lt_phrase": ["already conducted", "post"],
       "gt_phrase": ["not yet conducted", "post"]}
    ]
  },
  "tools": {
    "list_child": {"name": "lst_insp",
                   "desc": "list all insp recs"},
    "get_child": {"name": "get_insp",
                  "desc": "get one insp by id"},
    "list_parent": {"name": "lst_prop",
                    "desc": "list all proprietors on file"},
    "get_parent": {"name": "get_prop",
                   "desc": "get one proprietor by id"},
    "delete_child": {"name": "del_insp",
                     "desc": "wipe an insp rec, no undo",
                     "verbs": ["delete {obj}", "wipe {obj}"]},
    "set_enum": {"name": "set_insp_outc",
                 "desc": "chg insp outcome",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"scheduled": "back to scheduled",
                                   "passed": "as passed",
                                   "failed": "as failed",
                                   "corrected": "as corrected"}},
    "set_bool": {"name": "flag_viol",
                 "bool_index": 0, "value": true,
                 "desc": "flag insp w a violation",
                 "verbs": ["cite {obj}", "flag {obj} for a violation"]},
    "set_ref": {"name": "mv_insp",
                "desc": "move insp to diff proprietor",
                "verbs": ["move {obj} {to_name}", "reassign {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "call_prop",
             "desc": "call the proprietor",
             "child_verbs": ["call the proprietor for {obj}",
                             "ring the proprietor on {obj}"],
             "direct_verbs": ["call {name}", "ring {name}"],
             "pair_verbs": ["call", "ring"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the inspection with the earliest visit date",
    "ord_phrase": "the inspection with the {ord} earliest visit date",
    "pre_filter": {"bool_index": 0, "value": true, "phrase": "cited"}
  },
  "ambiguous": [
    {"request": ["Deal with the overdue sites.",
                 "Chase down the visits that already happened without a checkin."],
     "hint": "flag scheduled inspections whose visit date has already passed as violations",
     "clauses": [{"enum_value": "scheduled"},
                 {"time_index": 0, "op": "LT"}],
     "action": "set_bool"},
    {"request": ["Clear the closed-out backlog.",
                 "Get rid of the finished inspection records."],
     "hint": "delete passed inspections whose visit date has already passed",
     "clauses": [{"enum_value": "passed"},
                 {"time_index": 0, "op": "LT"}],
     "action": "delete_child"}
  ],
  "banks": {
    "child_msgs": ["insp needs a look",
                   "pls review your insp record",
                   "insp status changed",
                   "reinspection may be needed"],
    "agg_msgs": ["you have the most open insps rn",
                 "flagging this to you direct",
                 "you lead this count"],
    "fail_msgs": ["op failed",
                  "insp update didnt go thru",
                  "last action failed"]
  }
}
