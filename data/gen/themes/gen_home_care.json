{
  "domain": "home_care",
  "desc_style": "sloppy",
  "parent": {
    "entity": "client",
    "noun": ["client", "clients"],
    "name_style": "person",
    "contact_field": "email"
  },
  "child": {
    "entity": "care_visit",
    "noun": ["care visit", "care visits"],
    "ref_field": "client",
    "ref_phrase": "for {name}",
    "name_field": "visit_type",
    "titles": ["Personal care and hygiene assistance", "Medication reminder visit",
               "Meal prep and light housekeeping", "Mobility and transfer assistance",
               "Companion care visit", "Post-hospital recovery support",
               "Wound care check-in", "Overnight respite care",
               "Bathing assistance visit", "Dementia care support visit",
               "Physical therapy exercise support", "Grocery and errand assistance",
               "Vitals check visit"],
    "bools": [
      {"field": "care_plan_flagged", "true_phrase": "flagged for care plan review",
       "false_phrase": "not flagged for review", "placement": "pre"}
    ],
    "enum": {
      "field": "visit_status", "values": ["scheduled", "in_progress", "completed"],
      "phrases": {"scheduled": ["upcoming", "pre"],
                  "in_progress": ["in progress", "pre"],
                  "completed": ["completed", "pre"]}
    },
    "times": [
      {"field": "visit_window", "kind": "time_now",
       "lt_phrase": ["already missed", "post"],
       "gt_phrase": ["still upcoming", "post"]},
      {"field": "care_plan_updated", "kind": "time_cutoff",
       "phrase": "care plan updated more than {d} days ago"}
    ]
  },
  "tools": {
    "list_child": {"name": "listVisits", "desc": "list all the care visits, everything on file"},
    "get_child": {"name": "getVisit", "desc": "grab one visit by id"},
    "list_parent": {"name": "listClients", "desc": "list clients we got on file"},
    "get_parent": {"name": "getClient", "desc": "grab a client by id"},
    "delete_child": {"name": "nukeVisit", "desc": "kills a visit record for good, cant undo it",
                     "verbs": ["nuke {obj}", "wipe {obj}"]},
    "set_enum": {"name": "setVisitStatus", "desc": "flips a visit's status - scheduled, in progress, or done",
                 "verbs": ["mark {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"scheduled": "back to scheduled",
                                   "in_progress": "as in progress",
                                   "completed": "as done"}},
    "set_bool": {"name": "flagCarePlanReview", "bool_index": 0, "value": true,
                 "desc": "flags a visit's care plan for review",
                 "verbs": ["flag {obj} for care plan review", "mark {obj} for review"]},
    "set_ref": {"name": "moveClient", "desc": "shifts a visit over to a diff client",
                "verbs": ["move {obj} {to_name}", "shift {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "pingClient", "desc": "fires off a text to a client",
             "child_verbs": ["text the client on {obj}", "give the client on {obj} a nudge"],
             "direct_verbs": ["text {name}", "ping {name}"],
             "pair_verbs": ["text", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the care visit with the earliest visit window",
    "ord_phrase": "the care visit with the {ord} earliest visit window",
    "pre_filter": {"enum_value": "scheduled", "phrase": "scheduled"}
  },
  "ambiguous": [
    {"request": ["Clean up the visit log.", "The visit list is a mess, sort it."],
     "hint": "delete completed care visits",
     "clauses": [{"enum_value": "completed"}],
     "action": "delete_child"},
    {"request": ["Flag whoever's care plan is stale.", "Deal with the old care plans."],
     "hint": "flag scheduled care visits whose care plan was updated more than 90 days ago for review",
     "clauses": [{"enum_value": "scheduled"}, {"time_index": 1, "days": 90}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["hey, quick update on your care visit",
                   "your care visit needs a look",
                   "heads up about your upcoming visit",
                   "your visit might need rescheduling"],
    "agg_msgs": ["you've got the most visits on this list rn",
                 "flagging this one straight to you",
                 "you're on top of this count"],
    "fail_msgs": ["that didn't go through",
                  "couldn't finish that action",
                  "the update failed to save"]
  }
}
