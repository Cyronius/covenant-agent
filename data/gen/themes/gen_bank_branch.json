{
  "domain": "bank_branch",
  "desc_style": "terse",
  "parent": {
    "entity": "applicant",
    "noun": ["applicant", "applicants"],
    "name_style": "person",
    "contact_field": "email"
  },
  "child": {
    "entity": "loan_application",
    "noun": ["loan application", "loan applications"],
    "ref_field": "applicant",
    "ref_phrase": "from {name}",
    "name_field": "loan_purpose",
    "titles": ["Home purchase", "Auto loan", "Debt consolidation", "Home equity line",
               "Business startup capital", "Home renovation", "Student loan refinance",
               "Boat purchase", "Medical expenses", "Wedding expenses",
               "Investment property purchase", "Personal line of credit"],
    "bools": [
      {"field": "escalated", "true_phrase": "escalated",
       "false_phrase": "not escalated", "placement": "pre"}
    ],
    "enum": {
      "field": "stage", "values": ["submitted", "underwriting", "approved", "declined"],
      "phrases": {"submitted": ["submitted", "pre"],
                  "underwriting": ["in underwriting", "post"],
                  "approved": ["approved", "pre"],
                  "declined": ["declined", "pre"]}
    },
    "times": [
      {"field": "decision_due", "kind": "time_now",
       "lt_phrase": ["already overdue", "post"],
       "gt_phrase": ["not yet due", "post"]},
      {"field": "submitted_on", "kind": "time_cutoff",
       "phrase": "submitted more than {d} days ago"}
    ]
  },
  "tools": {
    "list_child": {"name": "listLoanApps",
                   "desc": "list all loan apps"},
    "get_child": {"name": "getLoanApp",
                  "desc": "fetch one loan app by id"},
    "list_parent": {"name": "listApplicants",
                    "desc": "list all applicants"},
    "get_parent": {"name": "getApplicant",
                   "desc": "fetch one applicant by id"},
    "delete_child": {"name": "purgeLoanApp",
                     "desc": "rm a loan app rec, no undo",
                     "verbs": ["purge {obj}", "wipe {obj} from the queue"]},
    "set_enum": {"name": "setLoanStage",
                 "desc": "chg loan app stage (submitted/underwriting/approved/declined)",
                 "verbs": ["move {obj} {to_value}", "set {obj} {to_value}"],
                 "value_phrases": {"submitted": "back to submitted",
                                   "underwriting": "to underwriting",
                                   "approved": "as approved",
                                   "declined": "as declined"}},
    "set_bool": {"name": "flagEscalated",
                 "bool_index": 0, "value": true,
                 "desc": "flag a loan app as escalated",
                 "verbs": ["escalate {obj}", "flag {obj} as escalated"]},
    "set_ref": {"name": "reassignApplicant",
                "desc": "move a loan app to a diff applicant",
                "verbs": ["reassign {obj} {to_name}", "move {obj} {to_name}"],
                "to_template": "to {name}"},
    "send": {"name": "emailApplicant",
             "desc": "send an email to an applicant",
             "child_verbs": ["email the applicant on {obj}",
                             "follow up by email on {obj}"],
             "direct_verbs": ["email {name}", "send {name} an email"],
             "pair_verbs": ["email", "notify"]}
  },
  "sort": {
    "time_index": 0,
    "dir": "ASC",
    "sup_phrase": "the loan application with the soonest decision due",
    "ord_phrase": "the loan application with the {ord} soonest decision due",
    "pre_filter": {"enum_value": "underwriting", "phrase": "in underwriting"}
  },
  "ambiguous": [
    {"request": ["Clear the dead pile.",
                 "These never went anywhere, get rid of them."],
     "hint": "delete declined loan applications submitted more than 180 days ago",
     "clauses": [{"enum_value": "declined"},
                 {"time_index": 1, "days": 180}],
     "action": "delete_child"},
    {"request": ["Handle the overdue decisions.",
                 "Some of these blew past their due date."],
     "hint": "flag as escalated the underwriting loan applications already past their decision due date",
     "clauses": [{"enum_value": "underwriting"},
                 {"time_index": 0, "op": "LT"}],
     "action": "set_bool"}
  ],
  "banks": {
    "child_msgs": ["Your loan application needs attention.",
                   "Please review your loan application status.",
                   "A note about your loan application.",
                   "Your loan application may need additional documentation."],
    "agg_msgs": ["You're currently at the top of this list.",
                 "Flagging this to you directly.",
                 "You lead this count right now."],
    "fail_msgs": ["The requested operation failed.",
                  "That action could not be completed.",
                  "The last operation did not go through."]
  }
}
